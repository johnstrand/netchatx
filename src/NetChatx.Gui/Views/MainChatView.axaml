<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetChatx.Gui.ViewModels"
             xmlns:views="using:NetChatx.Gui.Views"
             xmlns:conv="using:NetChatx.Gui.Converters"
             xmlns:controls="using:NetChatx.Gui.Controls"
             x:Class="NetChatx.Gui.Views.MainChatView"
             x:DataType="vm:MainChatViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Resources>
        <conv:DirectionToAlignmentConverter x:Key="DirectionToAlignment" />
        <conv:DirectionToBackgroundConverter x:Key="DirectionToBackground" />
        <conv:DirectionToForegroundConverter x:Key="DirectionToForeground" />
        <conv:PresenceToBrushConverter x:Key="PresenceToBrush" />
        <conv:BoolToLockIconConverter x:Key="BoolToLockIcon" />
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding OpenNewChatDialogCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Button.image-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.image-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.reaction-picker-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.reaction-picker-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Button.reaction-badge">
            <Setter Property="Background" Value="#162032" />
            <Setter Property="BorderBrush" Value="#24334C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Button.reaction-badge.reacted">
            <Setter Property="Background" Value="#2A1B4E" />
            <Setter Property="BorderBrush" Value="#A855F7" />
        </Style>
        <Style Selector="Border.bubble-container">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#23324C" />
            <Setter Property="BoxShadow" Value="0 3 10 0 #40000000" />
        </Style>
        <Style Selector="Border.bubble-container StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bubble-container:pointerover StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.quick-emoji-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Button.quick-emoji-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootChatGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT COLUMN: SIDEBAR ================= -->
        <Grid x:Name="SidebarGrid" Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto"
              Background="#0B0F19"
              IsVisible="{Binding IsSidebarOpen}">

            <!-- Row 0: Current User Presence Bar -->
            <Border Grid.Row="0" Padding="14,12" Background="#0F172A"
                    BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <!-- User Status Dot & Avatar with Logo Icon -->
                    <Panel Grid.Column="0" Width="34" Height="34" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True">
                            <Image Source="/Assets/netchatx-logo.png" Width="34" Height="34" Stretch="UniformToFill" />
                        </Border>
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding UserPresence, Converter={StaticResource PresenceToBrush}}"
                                 Stroke="#0F172A"
                                 StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserBoundJid}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Start New Chat / Add Contact Button -->
                    <Button Grid.Column="2" Content="+"
                            ToolTip.Tip="Start New Chat / Add Contact (Ctrl+N)"
                            Command="{Binding OpenNewChatDialogCommand}"
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                            Foreground="#00F0FF" FontWeight="Bold" FontSize="15"
                            CornerRadius="6"
                            Width="28" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Margin="4,0,2,0" />
                    <!-- Status Menu Button -->
                    <DropDownButton Grid.Column="3" Content="●"
                                    Foreground="{Binding UserPresence, Converter={StaticResource PresenceToBrush}}"
                                    Background="Transparent" BorderThickness="0">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Online" Command="{Binding SetPresenceCommand}" CommandParameter="available" />
                                <MenuItem Header="Away" Command="{Binding SetPresenceCommand}" CommandParameter="away" />
                                <MenuItem Header="Do Not Disturb" Command="{Binding SetPresenceCommand}" CommandParameter="dnd" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <!-- Collapse Sidebar Button -->
                    <Button Grid.Column="4" Content="◀"
                            ToolTip.Tip="Collapse Sidebar (Ctrl+B)"
                            Command="{Binding CollapseSidebarCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,4" Margin="2,0,0,0"
                            FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Row 1: Search Bar -->
            <Border Grid.Row="1" Padding="10,8" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="SearchInputBox" Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Search messages (Ctrl+F)..."
                             Height="32" VerticalContentAlignment="Center"
                             Background="#090D16" BorderBrush="#1E293B" Foreground="#F8FAFC" />
                    <Button Grid.Column="1" Content="🔍" Command="{Binding ExecuteSearchCommand}" ToolTip.Tip="Search Messages (Enter)" Margin="6,0,0,0" Height="32" Width="36" />
                </Grid>
            </Border>

            <!-- Row 2: Search Results or Tabs (Chats & Contacts) -->
            <!-- Search Results View -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding IsSearching}">
                <Border Grid.Row="0" Padding="12,6" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SearchResultsHeader}" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close ✕" Command="{Binding CloseSearchCommand}" FontSize="11" Padding="6,2" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MessageBubbleViewModel}">
                            <Button Command="{Binding ((vm:MainChatViewModel)DataContext).SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" Padding="8,6">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SenderName}" FontWeight="SemiBold" FontSize="12" Foreground="#00F0FF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedDateTime}" Foreground="#64748B" FontSize="10" />
                                    </Grid>
                                    <TextBlock Text="{Binding Body}" Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Normal Navigation Tabs (Chats / Contacts) -->
            <TabControl Grid.Row="2" IsVisible="{Binding !IsSearching}" Margin="0">
                <!-- Chats Tab -->
                <TabItem Header="Chats">
                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding ActiveConversation, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatConversationViewModel}">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RemoteJid}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="🔒" IsVisible="{Binding IsEncrypted}" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <!-- Contacts Roster Tab -->
                <TabItem Header="Contacts">
                    <ListBox ItemsSource="{Binding Contacts}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContactItemViewModel}">
                                <Button Command="{Binding ((vm:MainChatViewModel)DataContext).SelectContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="4,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Online indicator -->
                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                 Fill="{Binding PresenceShow, Converter={StaticResource PresenceToBrush}}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ContactJid}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Unread badge -->
                                        <Border Grid.Column="2" Background="{StaticResource NetChatxCyberGradient}"
                                                CornerRadius="10" Padding="6,2"
                                                IsVisible="{Binding UnreadCount}" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <!-- Row 3: Bottom Action Bar -->
            <Border Grid.Row="3" Padding="12,8" Background="#0F172A"
                    BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="⚙ Preferences" Command="{Binding OpenChatSettingsCommand}" Padding="8,4" />
                </Grid>
            </Border>
        </Grid>

        <!-- Column 1: Grid Splitter -->
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="2"
                      Background="#1E293B"
                      ResizeDirection="Columns"
                      IsVisible="{Binding IsSidebarOpen}" />

        <!-- ================= CENTER COLUMN: CONVERSATION PANE ================= -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto" Background="#080C14">

            <!-- Top Chat Header (Active Conversation) -->
            <Border Grid.Row="0" Padding="16,10" Background="#0F172A"
                    BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                    IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <!-- Toggle/Restore Sidebar Button -->
                    <Button Grid.Column="0"
                            Content="{Binding SidebarToggleIcon}"
                            ToolTip.Tip="{Binding SidebarToggleTooltip}"
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="6,4" Margin="0,0,8,0"
                            FontSize="13" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveConversation.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding ActiveConversation.RemoteJid}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <!-- Encryption Badge -->
                    <Border Grid.Column="2" Background="#11243A" BorderBrush="#00F0FF" BorderThickness="1"
                            CornerRadius="12" Padding="8,4" Margin="0,0,10,0"
                            IsVisible="{Binding ActiveConversation.IsEncrypted}" VerticalAlignment="Center">
                        <TextBlock Text="🔒 OMEMO Active" FontSize="11" FontWeight="SemiBold" Foreground="#67E8F9" />
                    </Border>
                    <!-- Sync Button -->
                    <Button Grid.Column="3" Content="{Binding ActiveConversation.SyncButtonText}"
                            Command="{Binding ActiveConversation.SyncArchiveCommand}"
                            IsEnabled="{Binding !ActiveConversation.IsSyncing}"
                            FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <!-- Toggle Details Button -->
                    <Button Grid.Column="4" Content="Details ℹ" Command="{Binding ToggleDetailsCommand}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Top Header Bar when no active conversation and sidebar is collapsed -->
            <Border Grid.Row="0" Padding="14,10" Background="#0F172A"
                    BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                    IsVisible="{Binding ShowEmptyStateHeader}">
                <Button Content="▶ Restore Sidebar"
                        ToolTip.Tip="Restore Sidebar (Ctrl+B)"
                        Command="{Binding RestoreSidebarCommand}"
                        Padding="8,4" FontSize="12" />
            </Border>

            <!-- Center: Messages Scroll Area -->
            <Grid Grid.Row="1" IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer x:Name="MessagesScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="16">
                        <!-- Load Older Messages Button -->
                        <Button Content="{Binding ActiveConversation.LoadOlderButtonText}"
                                Command="{Binding ActiveConversation.LoadOlderHistoryCommand}"
                                IsEnabled="{Binding !ActiveConversation.IsLoadingOlderHistory}"
                                HorizontalAlignment="Center"
                                FontSize="12" Padding="12,4" Margin="0,0,0,8" />

                        <!-- Messages List -->
                        <ItemsControl ItemsSource="{Binding ActiveConversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MessageBubbleViewModel}">
                                    <StackPanel Margin="0,2">
                                        <!-- Centered Date Header Separator -->
                                        <Border HorizontalAlignment="Center"
                                                Background="#131D2D"
                                                BorderBrush="#1E293B"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,3"
                                                Margin="0,8,0,6"
                                                IsVisible="{Binding ShowDateHeader}">
                                            <TextBlock Text="{Binding DateHeader}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#94A3B8" />
                                        </Border>

                                        <!-- Message Bubble Container -->
                                        <Border Classes="bubble-container"
                                                HorizontalAlignment="{Binding Direction, Converter={StaticResource DirectionToAlignment}}"
                                                Background="{Binding Direction, Converter={StaticResource DirectionToBackground}}"
                                                CornerRadius="14"
                                                Padding="12,8"
                                                MaxWidth="580"
                                                BoxShadow="0 1 3 0 #15000000">
                                            <Border.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="📋 Copy Text" Command="{Binding CopyTextCommand}" />
                                                    <MenuItem Header="🌐 Open Link" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding Links[0]}" IsVisible="{Binding HasLinks}" />
                                                    <MenuItem Header="📋 Copy Link" Command="{Binding CopyLinkCommand}" CommandParameter="{Binding Links[0]}" IsVisible="{Binding HasLinks}" />
                                                    <MenuItem Header="↩ Reply" Command="{Binding ReplyCommand}" />
                                                    <MenuItem Header="✏️ Edit Message" Command="{Binding EditCommand}" IsVisible="{Binding IsOutbound}" />
                                                    <MenuItem Header="🗑 Delete Message" Command="{Binding DeleteCommand}" />
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <StackPanel Spacing="4">
                                                <!-- Sender Name for group chats + Action Buttons -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SenderName}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                               Opacity="0.85" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="bubble-actions" Orientation="Horizontal" Spacing="4">
                                                        <!-- Emoji Reaction Button with Flyout -->
                                                        <Button Content="😀+" ToolTip.Tip="Add reaction"
                                                                Classes="image-btn reaction-picker-btn"
                                                                FontSize="12" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}">
                                                            <Button.Flyout>
                                                                <Flyout Placement="Top">
                                                                    <StackPanel Spacing="6" Width="300" DataContext="{Binding EmojiPicker}">
                                                                        <!-- Quick Emojis Bar + '+' + Customize -->
                                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding QuickEmojis}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate DataType="{x:Type x:String}">
                                                                                        <Button Content="{Binding}"
                                                                                                Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Classes="quick-emoji-item"
                                                                                                FontSize="17" Padding="3,1"
                                                                                                ToolTip.Tip="{Binding}"
                                                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <Button Grid.Column="1" Content="➕"
                                                                                    Command="{Binding ToggleFullPickerCommand}"
                                                                                    ToolTip.Tip="All Emojis"
                                                                                    Classes="image-btn" FontSize="12" Padding="4,2"
                                                                                    VerticalAlignment="Center" Margin="2,0" />

                                                                            <Button Grid.Column="2" Content="⚙"
                                                                                    Command="{Binding ToggleCustomizeCommand}"
                                                                                    ToolTip.Tip="Customize Quick Emojis"
                                                                                    Classes="image-btn" FontSize="12" Padding="4,2"
                                                                                    VerticalAlignment="Center" Margin="2,0" />
                                                                        </Grid>

                                                                        <!-- Customize Banner -->
                                                                        <Border Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="6" Padding="6,4"
                                                                                IsVisible="{Binding IsCustomizing}">
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <TextBlock Grid.Column="0" Text="Click any emoji below or right-click to pin/unpin"
                                                                                           FontSize="10" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                                <Button Grid.Column="1" Content="Done" Command="{Binding ToggleCustomizeCommand}"
                                                                                        FontSize="10" Padding="6,2" Margin="4,0,0,0" />
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Expandable Full Picker -->
                                                                        <StackPanel Spacing="6" IsVisible="{Binding IsFullPickerOpen}">
                                                                            <Separator Margin="0,2" />

                                                                            <!-- Search Box -->
                                                                            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                                                                     Watermark="Search emojis..."
                                                                                     FontSize="12" Padding="6,4" />

                                                                            <!-- Category Tabs -->
                                                                            <ItemsControl ItemsSource="{Binding Categories}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button Content="{Binding Icon}"
                                                                                                Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding Name}"
                                                                                                ToolTip.Tip="{Binding Name}"
                                                                                                FontSize="14" Padding="6,2"
                                                                                                Background="Transparent" BorderThickness="0" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <!-- Emojis Grid -->
                                                                            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                                <ItemsControl ItemsSource="{Binding DisplayedEmojis}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type x:String}">
                                                                                            <Button Content="{Binding}"
                                                                                                    Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding}"
                                                                                                    FontSize="16" Padding="3,2" Margin="1"
                                                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                                                                <Button.ContextFlyout>
                                                                                                    <MenuFlyout>
                                                                                                        <MenuItem Header="📌 Pin to Quick Emojis"
                                                                                                                  Command="{Binding ((vm:EmojiPickerViewModel)DataContext).PinToQuickEmojisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                  CommandParameter="{Binding}" />
                                                                                                        <MenuItem Header="🗑 Remove from Quick Emojis"
                                                                                                                  Command="{Binding ((vm:EmojiPickerViewModel)DataContext).RemoveFromQuickEmojisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                  CommandParameter="{Binding}" />
                                                                                                    </MenuFlyout>
                                                                                                </Button.ContextFlyout>
                                                                                            </Button>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Content="↩" Command="{Binding ReplyCommand}"
                                                                ToolTip.Tip="Reply"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        <Button Content="✏️" Command="{Binding EditCommand}"
                                                                ToolTip.Tip="Edit Message"
                                                                IsVisible="{Binding IsOutbound}"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        <Button Content="🗑" Command="{Binding DeleteCommand}"
                                                                ToolTip.Tip="Delete Message"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        <Button Content="📋" Command="{Binding CopyTextCommand}"
                                                                ToolTip.Tip="Copy Text"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Message Content with Clickable Hyperlinks and Markdown -->
                                                <controls:HyperlinkTextBlock Text="{Binding Body}"
                                                                             IsMarkdownEnabled="{Binding !IsUnstyled}"
                                                                             MessageDirection="{Binding Direction}"
                                                                             Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                                             FontSize="13"
                                                                             TextWrapping="Wrap"
                                                                             IsVisible="{Binding !IsOnlyImage}" />

                                                <!-- Image Thumbnail Preview if present -->
                                                <Button Classes="image-btn"
                                                        Command="{Binding OpenImageCommand}"
                                                        CornerRadius="8" ClipToBounds="True" Margin="0,2"
                                                        IsVisible="{Binding HasImage}"
                                                        MaxWidth="380" MaxHeight="260" HorizontalAlignment="Left"
                                                        Cursor="Hand">
                                                    <Panel Background="#15888888">
                                                        <!-- Loading indicator -->
                                                        <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                                                                     IsVisible="{Binding IsLoadingImage}"
                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                        <!-- Thumbnail Image -->
                                                        <Image Source="{Binding ImageThumbnail}"
                                                               Stretch="Uniform"
                                                               MaxWidth="380" MaxHeight="260"
                                                               IsVisible="{Binding ImageThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                        <!-- GIF Badge Overlay -->
                                                        <Border Background="#CC000000" CornerRadius="4" Padding="5,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                                                IsVisible="{Binding IsGif}">
                                                            <TextBlock Text="GIF" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                    </Panel>
                                                </Button>

                                                <!-- Message Reactions Display Badges -->
                                                <ItemsControl ItemsSource="{Binding Reactions}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ReactionCountViewModel}">
                                                            <Button Classes="reaction-badge"
                                                                    Classes.reacted="{Binding IsReactedByMe}"
                                                                    Command="{Binding ToggleCommand}"
                                                                    Margin="0,2,4,2">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding Emoji}" FontSize="12" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Message Footer: Time + Receipt + Raw XML Toggle -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                                                        <Button Classes="image-btn"
                                                                Command="{Binding ToggleRawXmlCommand}"
                                                                ToolTip.Tip="Toggle Raw XML"
                                                                Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="&lt;/&gt;" FontSize="10" Opacity="0.8"
                                                                       Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        </Button>
                                                        <TextBlock Text="(edited)" FontSize="10" FontStyle="Italic"
                                                                   IsVisible="{Binding IsEdited}"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                                   Opacity="0.75" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                                   Opacity="0.75" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ReceiptIcon}" FontSize="10"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                                   Opacity="0.9" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Raw XML View Container -->
                                                <Border IsVisible="{Binding IsRawXmlVisible}"
                                                        Background="#20000000"
                                                        CornerRadius="6"
                                                        Padding="8,6"
                                                        Margin="0,4,0,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Raw XML" FontSize="10" FontWeight="Bold" Opacity="0.8"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        <TextBox Text="{Binding RawXml, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 FontFamily="Consolas, monospace"
                                                                 FontSize="11"
                                                                 MaxHeight="180"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Empty State Placeholder when no active conversation -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14"
                        IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNull}}">
                <Border Width="100" Height="100" CornerRadius="24" ClipToBounds="True"
                        HorizontalAlignment="Center"
                        BoxShadow="0 8 28 0 #3000C8FF">
                    <Image Source="/Assets/netchatx-logo.png" Width="100" Height="100" Stretch="UniformToFill" />
                </Border>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="Welcome to NetChatx" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a contact or conversation from the sidebar to begin chatting." Classes="muted" HorizontalAlignment="Center" />
                </StackPanel>
                <Button Content="▶ Restore Sidebar"
                        Command="{Binding RestoreSidebarCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        IsVisible="{Binding !IsSidebarOpen}" />
            </StackPanel>

            <!-- Typing Indicator -->
            <Border Grid.Row="2" Padding="16,4" IsVisible="{Binding ActiveConversation.IsRemoteComposing}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ActiveConversation.Title, StringFormat='{}{0} is typing...'}"
                               FontStyle="Italic"
                               Foreground="#00F0FF"
                               FontSize="11" />
                </StackPanel>
            </Border>

            <!-- Bottom Message Input Bar with Pending Attachment Preview -->
            <Border Grid.Row="3" Padding="14,10" Background="#0F172A"
                    BorderBrush="#1E293B" BorderThickness="0,1,0,0"
                    IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8">
                    <!-- Pending Image Preview Bar -->
                    <Border Background="#131C2D"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            IsVisible="{Binding ActiveConversation.HasPendingImage}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Image Thumbnail Preview -->
                            <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Width="56" Height="56" Background="#090D16">
                                <Image Source="{Binding ActiveConversation.PendingImagePreview}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <!-- Image Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding ActiveConversation.PendingImageHeader, FallbackValue='📷 Image ready to send'}"
                                               FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" />
                                    <TextBlock Text="{Binding ActiveConversation.PendingImageSizeText, StringFormat='({0})'}"
                                               Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveConversation.PendingImageFileName}"
                                           Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Discard / Remove Button -->
                            <Button Grid.Column="2"
                                    Content="✕"
                                    ToolTip.Tip="Remove Image (Esc)"
                                    Command="{Binding ActiveConversation.ClearPendingImageCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#94A3B8"
                                    Width="28" Height="28"
                                    Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Editing Message Banner -->
                    <Border Background="#1E1B38"
                            BorderBrush="#A855F7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            IsVisible="{Binding ActiveConversation.IsEditingMessage}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="✏️" FontSize="15" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Editing message" FontWeight="SemiBold" FontSize="12" Foreground="#00F0FF" />
                                <TextBlock Text="{Binding ActiveConversation.EditingMessagePreviewText}"
                                           Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    ToolTip.Tip="Cancel Editing (Esc)"
                                    Command="{Binding ActiveConversation.CancelEditingMessageCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#94A3B8"
                                    Width="28" Height="28"
                                    Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Replying to Message Banner -->
                    <Border Background="#131C2D"
                            BorderBrush="#00F0FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8"
                            IsVisible="{Binding ActiveConversation.HasReplyingMessage}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="↩" FontSize="15" Foreground="#00F0FF" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding ActiveConversation.ReplyingToMessage.SenderName, StringFormat='Replying to {0}'}"
                                           FontWeight="SemiBold" FontSize="12" Foreground="#00F0FF" />
                                <TextBlock Text="{Binding ActiveConversation.ReplyingToMessage.Body}"
                                           Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    ToolTip.Tip="Cancel Reply (Esc)"
                                    Command="{Binding ActiveConversation.CancelReplyingMessageCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#94A3B8"
                                    Width="28" Height="28"
                                    Padding="0"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Message Input & Send Controls -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBox x:Name="MessageInputBox"
                                 Grid.Column="0"
                                 Text="{Binding ActiveConversation.InputText, Mode=TwoWay}"
                                 Watermark="Type a message... (Enter to send, Shift+Enter for newline, or ``` for code)"
                                 AcceptsReturn="True"
                                 Background="#090D16"
                                 BorderBrush="#1E293B"
                                 CornerRadius="8"
                                 Foreground="#F8FAFC"
                                 MaxHeight="100"
                                 VerticalContentAlignment="Center" />
                        <Button x:Name="InsertCodeBlockButton"
                                Grid.Column="1"
                                Content="&lt;/&gt;"
                                ToolTip.Tip="Insert Code Block (```)"
                                Height="36" Width="36"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0"
                                Margin="8,0,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Button x:Name="AttachFileButton"
                                Grid.Column="2"
                                Content="📎"
                                ToolTip.Tip="Attach Image"
                                Height="36" Width="36"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0"
                                Margin="8,0,0,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="{Binding ActiveConversation.SendButtonIcon}"
                                ToolTip.Tip="{Binding ActiveConversation.SendButtonToolTip}"
                                Classes="accent"
                                Command="{Binding ActiveConversation.SendMessageCommand}"
                                Height="36" Width="36"
                                Padding="0"
                                Margin="8,0,0,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= RIGHT COLUMN: COLLAPSIBLE DETAILS DRAWER ================= -->
        <Border Grid.Column="3" Width="300" Background="#0B0F19"
                BorderBrush="#1E293B" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsDetailsOpen}">
            <ScrollViewer>
                <StackPanel Spacing="16" Margin="16">
                    <!-- Drawer Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Details &amp; Security" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding ToggleDetailsCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="6,2" />
                    </Grid>

                    <!-- Contact Details -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Contact JID" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding ActiveConversation.RemoteJid}" FontSize="13" Foreground="#F1F5F9" TextWrapping="Wrap" />
                    </StackPanel>

                    <Separator Background="#1E293B" Height="1" />

                    <!-- Chat Preferences & Bubble Merging -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Chat Preferences" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="Merge consecutive messages sent within seconds into a single chat bubble." Foreground="#64748B" TextWrapping="Wrap" FontSize="11" />

                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding EnableMessageMerging, Mode=TwoWay}"
                                              OnContent="Merge consecutive messages"
                                              OffContent="Merge consecutive messages"
                                              FontSize="12" />

                                <StackPanel Spacing="4" IsVisible="{Binding EnableMessageMerging}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Merge threshold" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding MessageMergeThresholdSeconds, StringFormat='{}{0} seconds'}"
                                                   FontWeight="SemiBold" FontSize="11" Foreground="#00F0FF" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="60"
                                            Value="{Binding MessageMergeThresholdSeconds, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Separator Background="#1E293B" Height="1" />

                    <!-- OMEMO E2EE Fingerprints -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="OMEMO Device Fingerprints" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="Verify device identity keys to ensure communication is secure against eavesdropping." Foreground="#64748B" TextWrapping="Wrap" FontSize="11" />

                        <ItemsControl ItemsSource="{Binding OmemoDetails.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OmemoDeviceItemViewModel}">
                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding DeviceId, StringFormat='Device #{0}'}" FontWeight="Medium" FontSize="12" Foreground="#F8FAFC" />
                                                <TextBlock Grid.Column="1" Text="{Binding TrustState}" FontSize="11" Foreground="#94A3B8" />
                                            </Grid>
                                            <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" />
                                            <Button Content="{Binding IsTrusted, Converter={StaticResource BoolToLockIcon}}"
                                                    Command="{Binding ToggleTrustCommand}"
                                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6"
                                                    HorizontalAlignment="Right" FontSize="11" Padding="8,4" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Separator Background="#1E293B" Height="1" />

                    <!-- About NetChatx Branding Card -->
                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="14" ClipToBounds="True"
                                    HorizontalAlignment="Center"
                                    BoxShadow="0 4 16 0 #3000C8FF">
                                <Image Source="/Assets/netchatx-logo.png" Width="56" Height="56" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="NetChatx" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                <TextBlock Text="v1.0 • .NET 10 &amp; Avalonia" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Decentralized, encrypted, modern XMPP chat client."
                                       Foreground="#94A3B8" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= NEW CHAT / ADD CONTACT MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding IsNewChatDialogOpen}"
              ZIndex="999">
            <!-- Dark semi-transparent backdrop -->
            <Border Background="#80000000" PointerPressed="OnNewChatBackdropPressed" />
            <!-- Centered Card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" Padding="24" CornerRadius="16"
                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    BoxShadow="0 20 50 0 #60000000, 0 0 25 0 #2000F0FF">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Start New Chat" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" />
                            <TextBlock Text="Enter a contact's Jabber ID to begin messaging." Foreground="#64748B" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelNewChatDialogCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="6,2" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Contact JID" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="NewChatJidInput" Text="{Binding NewChatJid, Mode=TwoWay}"
                                 Watermark="e.g. alice@example.com"
                                 Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                 Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Display Name (Optional)" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <TextBox Text="{Binding NewChatDisplayName, Mode=TwoWay}"
                                 Watermark="e.g. Alice Cooper"
                                 Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                 Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding NewChatErrorMessage}"
                               Foreground="#F43F5E" FontSize="11"
                               IsVisible="{Binding NewChatErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelNewChatDialogCommand}"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                Foreground="#94A3B8"
                                Margin="0,0,8,0" Padding="14,6" CornerRadius="8" />
                        <Button Grid.Column="2" Content="Start Chat" Classes="accent" Command="{Binding ConfirmNewChatCommand}"
                                Padding="16,6" CornerRadius="8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= CODE BLOCK EDITOR MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding CodeBlockEditor.IsOpen}"
              ZIndex="1000">
            <!-- Dark semi-transparent backdrop (click to dismiss/cancel) -->
            <Border Background="#80000000" PointerPressed="OnCodeBlockEditorBackdropPressed" />
            <!-- Centered Modal Editor Card -->
            <views:CodeBlockEditorView DataContext="{Binding CodeBlockEditor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
