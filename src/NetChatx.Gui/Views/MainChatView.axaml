<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetChatx.Gui.ViewModels"
             xmlns:conv="using:NetChatx.Gui.Converters"
             x:Class="NetChatx.Gui.Views.MainChatView"
             x:DataType="vm:MainChatViewModel">

    <UserControl.Resources>
        <conv:DirectionToAlignmentConverter x:Key="DirectionToAlignment" />
        <conv:DirectionToBackgroundConverter x:Key="DirectionToBackground" />
        <conv:DirectionToForegroundConverter x:Key="DirectionToForeground" />
        <conv:PresenceToBrushConverter x:Key="PresenceToBrush" />
        <conv:BoolToLockIconConverter x:Key="BoolToLockIcon" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.image-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.image-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.reaction-picker-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.reaction-picker-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Button.reaction-badge">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemChromeHighColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Button.reaction-badge.reacted">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
        </Style>
        <Style Selector="Border.bubble-container StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bubble-container:pointerover StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.quick-emoji-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Button.quick-emoji-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="300,2,*,Auto">
        <!-- ================= LEFT COLUMN: SIDEBAR ================= -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SystemChromeLowColor}">

            <!-- Row 0: Current User Presence Bar -->
            <Border Grid.Row="0" Padding="14,12" Background="{DynamicResource SystemChromeMediumLowColor}"
                    BorderBrush="{DynamicResource SystemChromeMediumColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- User Status Dot & Avatar -->
                    <Ellipse Grid.Column="0" Width="32" Height="32" Fill="{DynamicResource AccentButtonBackground}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserBoundJid}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Status Menu Button -->
                    <DropDownButton Grid.Column="2" Content="●"
                                    Foreground="{Binding UserPresence, Converter={StaticResource PresenceToBrush}}"
                                    Background="Transparent" BorderThickness="0">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Online" Command="{Binding SetPresenceCommand}" CommandParameter="available" />
                                <MenuItem Header="Away" Command="{Binding SetPresenceCommand}" CommandParameter="away" />
                                <MenuItem Header="Do Not Disturb" Command="{Binding SetPresenceCommand}" CommandParameter="dnd" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </Border>

            <!-- Row 1: Search Bar -->
            <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource SystemChromeMediumColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery}" Watermark="Search messages or contacts..."
                             Height="32" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Content="🔍" Command="{Binding ExecuteSearchCommand}" Margin="6,0,0,0" Height="32" Width="36" />
                </Grid>
            </Border>

            <!-- Row 2: Search Results or Tabs (Chats & Contacts) -->
            <!-- Search Results View -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding IsSearching}">
                <Border Grid.Row="0" Padding="12,6" Background="{DynamicResource SystemChromeMediumColor}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Search Results" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close ✕" Command="{Binding CloseSearchCommand}" FontSize="11" Padding="6,2" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MessageBubbleViewModel}">
                            <StackPanel Spacing="2" Margin="4">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding SenderName}" FontWeight="SemiBold" FontSize="11" />
                                    <Button Grid.Column="1" Classes="image-btn" Command="{Binding ToggleRawXmlCommand}" ToolTip.Tip="Toggle Raw XML" Margin="4,0">
                                        <TextBlock Text="&lt;/&gt;" FontSize="10" Opacity="0.8" />
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedDateTime}" Classes="muted" FontSize="10" />
                                </Grid>
                                <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap" />
                                <Border IsVisible="{Binding IsRawXmlVisible}"
                                        Background="{DynamicResource SystemChromeMediumColor}"
                                        CornerRadius="4" Padding="6" Margin="0,4,0,0">
                                    <TextBox Text="{Binding RawXml, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             FontFamily="Consolas, monospace" FontSize="10" MaxHeight="120"
                                             Background="Transparent" BorderThickness="0" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Normal Navigation Tabs (Chats / Contacts) -->
            <TabControl Grid.Row="2" IsVisible="{Binding !IsSearching}" Margin="0">
                <!-- Chats Tab -->
                <TabItem Header="Chats">
                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding ActiveConversation, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatConversationViewModel}">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RemoteJid}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="🔒" IsVisible="{Binding IsEncrypted}" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <!-- Contacts Roster Tab -->
                <TabItem Header="Contacts">
                    <ListBox ItemsSource="{Binding Contacts}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContactItemViewModel}">
                                <Button Command="{Binding ((vm:MainChatViewModel)DataContext).SelectContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="4,2">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Online indicator -->
                                        <Ellipse Grid.Column="0" Width="10" Height="10"
                                                 Fill="{Binding PresenceShow, Converter={StaticResource PresenceToBrush}}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ContactJid}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Unread badge -->
                                        <Border Grid.Column="2" Background="{DynamicResource AccentButtonBackground}"
                                                CornerRadius="10" Padding="6,2"
                                                IsVisible="{Binding UnreadCount}" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <!-- Row 3: Bottom Action Bar -->
            <Border Grid.Row="3" Padding="12,8" Background="{DynamicResource SystemChromeMediumLowColor}"
                    BorderBrush="{DynamicResource SystemChromeMediumColor}" BorderThickness="0,1,0,0">
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </Border>
        </Grid>

        <!-- Column 1: Grid Splitter -->
        <GridSplitter Grid.Column="1" Width="2" Background="{DynamicResource SystemChromeMediumColor}" ResizeDirection="Columns" />

        <!-- ================= CENTER COLUMN: CONVERSATION PANE ================= -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto" Background="{DynamicResource SystemChromeAltHighColor}">

            <!-- Top Chat Header -->
            <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource SystemChromeMediumLowColor}"
                    BorderBrush="{DynamicResource SystemChromeMediumColor}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding ActiveConversation.Title}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveConversation.RemoteJid}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <!-- Encryption Badge -->
                    <Border Grid.Column="1" Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="12" Padding="8,4" Margin="0,0,10,0"
                            IsVisible="{Binding ActiveConversation.IsEncrypted}">
                        <TextBlock Text="🔒 OMEMO Active" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <!-- Sync Button -->
                    <Button Grid.Column="2" Content="Sync 🔄"
                            Command="{Binding ActiveConversation.SyncArchiveCommand}"
                            IsEnabled="{Binding !ActiveConversation.IsSyncing}"
                            FontSize="12" Margin="0,0,8,0" />
                    <!-- Toggle Details Button -->
                    <Button Grid.Column="3" Content="Details ℹ" Command="{Binding ToggleDetailsCommand}" FontSize="12" />
                </Grid>
            </Border>

            <!-- Center: Messages Scroll Area -->
            <Grid Grid.Row="1" IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer x:Name="MessagesScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="16">
                        <!-- Load Older Messages Button -->
                        <Button Content="{Binding ActiveConversation.LoadOlderButtonText}"
                                Command="{Binding ActiveConversation.LoadOlderHistoryCommand}"
                                IsEnabled="{Binding !ActiveConversation.IsLoadingOlderHistory}"
                                HorizontalAlignment="Center"
                                FontSize="12" Padding="12,4" Margin="0,0,0,8" />

                        <!-- Messages List -->
                        <ItemsControl ItemsSource="{Binding ActiveConversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MessageBubbleViewModel}">
                                    <StackPanel Margin="0,2">
                                        <!-- Centered Date Header Separator -->
                                        <Border HorizontalAlignment="Center"
                                                Background="{DynamicResource SystemChromeMediumColor}"
                                                BorderBrush="{DynamicResource SystemChromeHighColor}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,3"
                                                Margin="0,8,0,6"
                                                IsVisible="{Binding ShowDateHeader}">
                                            <TextBlock Text="{Binding DateHeader}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.85" />
                                        </Border>

                                        <!-- Message Bubble Container -->
                                        <Border Classes="bubble-container"
                                                HorizontalAlignment="{Binding Direction, Converter={StaticResource DirectionToAlignment}}"
                                                Background="{Binding Direction, Converter={StaticResource DirectionToBackground}}"
                                                CornerRadius="14"
                                                Padding="12,8"
                                                MaxWidth="580"
                                                BoxShadow="0 1 3 0 #15000000">
                                            <Border.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="📋 Copy Text" Command="{Binding CopyTextCommand}" />
                                                    <MenuItem Header="↩ Reply" Command="{Binding ReplyCommand}" />
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <StackPanel Spacing="4">
                                                <!-- Sender Name for group chats + Action Buttons -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SenderName}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                               Opacity="0.85" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Classes="bubble-actions" Orientation="Horizontal" Spacing="4">
                                                        <!-- Emoji Reaction Button with Flyout -->
                                                        <Button Content="😀+" ToolTip.Tip="Add reaction"
                                                                Classes="image-btn reaction-picker-btn"
                                                                FontSize="12" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}">
                                                            <Button.Flyout>
                                                                <Flyout Placement="Top">
                                                                    <StackPanel Spacing="6" Width="300" DataContext="{Binding EmojiPicker}">
                                                                        <!-- Quick Emojis Bar + '+' + Customize -->
                                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding QuickEmojis}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate DataType="{x:Type x:String}">
                                                                                        <Button Content="{Binding}"
                                                                                                Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Classes="quick-emoji-item"
                                                                                                FontSize="17" Padding="3,1"
                                                                                                ToolTip.Tip="{Binding}"
                                                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <Button Grid.Column="1" Content="➕"
                                                                                    Command="{Binding ToggleFullPickerCommand}"
                                                                                    ToolTip.Tip="All Emojis"
                                                                                    Classes="image-btn" FontSize="12" Padding="4,2"
                                                                                    VerticalAlignment="Center" Margin="2,0" />

                                                                            <Button Grid.Column="2" Content="⚙"
                                                                                    Command="{Binding ToggleCustomizeCommand}"
                                                                                    ToolTip.Tip="Customize Quick Emojis"
                                                                                    Classes="image-btn" FontSize="12" Padding="4,2"
                                                                                    VerticalAlignment="Center" Margin="2,0" />
                                                                        </Grid>

                                                                        <!-- Customize Banner -->
                                                                        <Border Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="6" Padding="6,4"
                                                                                IsVisible="{Binding IsCustomizing}">
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <TextBlock Grid.Column="0" Text="Click any emoji below or right-click to pin/unpin"
                                                                                           FontSize="10" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                                <Button Grid.Column="1" Content="Done" Command="{Binding ToggleCustomizeCommand}"
                                                                                        FontSize="10" Padding="6,2" Margin="4,0,0,0" />
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Expandable Full Picker -->
                                                                        <StackPanel Spacing="6" IsVisible="{Binding IsFullPickerOpen}">
                                                                            <Separator Margin="0,2" />

                                                                            <!-- Search Box -->
                                                                            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                                                                     Watermark="Search emojis..."
                                                                                     FontSize="12" Padding="6,4" />

                                                                            <!-- Category Tabs -->
                                                                            <ItemsControl ItemsSource="{Binding Categories}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button Content="{Binding Icon}"
                                                                                                Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding Name}"
                                                                                                ToolTip.Tip="{Binding Name}"
                                                                                                FontSize="14" Padding="6,2"
                                                                                                Background="Transparent" BorderThickness="0" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <!-- Emojis Grid -->
                                                                            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                                <ItemsControl ItemsSource="{Binding DisplayedEmojis}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type x:String}">
                                                                                            <Button Content="{Binding}"
                                                                                                    Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding}"
                                                                                                    FontSize="16" Padding="3,2" Margin="1"
                                                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                                                                <Button.ContextFlyout>
                                                                                                    <MenuFlyout>
                                                                                                        <MenuItem Header="📌 Pin to Quick Emojis"
                                                                                                                  Command="{Binding ((vm:EmojiPickerViewModel)DataContext).PinToQuickEmojisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                  CommandParameter="{Binding}" />
                                                                                                        <MenuItem Header="🗑 Remove from Quick Emojis"
                                                                                                                  Command="{Binding ((vm:EmojiPickerViewModel)DataContext).RemoveFromQuickEmojisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                  CommandParameter="{Binding}" />
                                                                                                    </MenuFlyout>
                                                                                                </Button.ContextFlyout>
                                                                                            </Button>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Content="↩" Command="{Binding ReplyCommand}"
                                                                ToolTip.Tip="Reply"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        <Button Content="📋" Command="{Binding CopyTextCommand}"
                                                                ToolTip.Tip="Copy Text"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Message Content -->
                                                <TextBlock Text="{Binding Body}"
                                                           Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding !IsOnlyImage}" />

                                                <!-- Image Thumbnail Preview if present -->
                                                <Button Classes="image-btn"
                                                        Command="{Binding OpenImageCommand}"
                                                        CornerRadius="8" ClipToBounds="True" Margin="0,2"
                                                        IsVisible="{Binding HasImage}"
                                                        MaxWidth="380" MaxHeight="260" HorizontalAlignment="Left"
                                                        Cursor="Hand">
                                                    <Panel Background="#15888888">
                                                        <!-- Loading indicator -->
                                                        <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                                                                     IsVisible="{Binding IsLoadingImage}"
                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                        <!-- Thumbnail Image -->
                                                        <Image Source="{Binding ImageThumbnail}"
                                                               Stretch="Uniform"
                                                               MaxWidth="380" MaxHeight="260"
                                                               IsVisible="{Binding ImageThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </Panel>
                                                </Button>

                                                <!-- Message Reactions Display Badges -->
                                                <ItemsControl ItemsSource="{Binding Reactions}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ReactionCountViewModel}">
                                                            <Button Classes="reaction-badge"
                                                                    Classes.reacted="{Binding IsReactedByMe}"
                                                                    Command="{Binding ToggleCommand}"
                                                                    Margin="0,2,4,2">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding Emoji}" FontSize="12" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Message Footer: Time + Receipt + Raw XML Toggle -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                                                        <Button Classes="image-btn"
                                                                Command="{Binding ToggleRawXmlCommand}"
                                                                ToolTip.Tip="Toggle Raw XML"
                                                                Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="&lt;/&gt;" FontSize="10" Opacity="0.8"
                                                                       Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        </Button>
                                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                                   Opacity="0.75" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ReceiptIcon}" FontSize="10"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}"
                                                                   Opacity="0.9" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Raw XML View Container -->
                                                <Border IsVisible="{Binding IsRawXmlVisible}"
                                                        Background="#20000000"
                                                        CornerRadius="6"
                                                        Padding="8,6"
                                                        Margin="0,4,0,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Raw XML" FontSize="10" FontWeight="Bold" Opacity="0.8"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                        <TextBox Text="{Binding RawXml, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 FontFamily="Consolas, monospace"
                                                                 FontSize="11"
                                                                 MaxHeight="180"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Foreground="{Binding Direction, Converter={StaticResource DirectionToForeground}}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Empty State Placeholder when no active conversation -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Welcome to NetChatx" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Select a contact or conversation from the sidebar to begin." Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Typing Indicator -->
            <Border Grid.Row="2" Padding="16,4" IsVisible="{Binding ActiveConversation.IsRemoteComposing}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ActiveConversation.Title, StringFormat='{}{0} is typing...'}" FontStyle="Italic" Classes="muted" FontSize="11" />
                </StackPanel>
            </Border>

            <!-- Bottom Message Input Bar -->
            <Border Grid.Row="3" Padding="14,10" Background="{DynamicResource SystemChromeMediumLowColor}"
                    BorderBrush="{DynamicResource SystemChromeMediumColor}" BorderThickness="0,1,0,0"
                    IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox x:Name="MessageInputBox"
                             Grid.Column="0"
                             Text="{Binding ActiveConversation.InputText, Mode=TwoWay}"
                             Watermark="Type a message... (Enter to send, Shift+Enter for newline, or paste image)"
                             AcceptsReturn="True"
                             MaxHeight="100"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="AttachFileButton"
                            Grid.Column="1"
                            Content="📎"
                            ToolTip.Tip="Attach Image"
                            Height="36" Width="36"
                            Padding="0"
                            Margin="8,0,0,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="➤"
                            ToolTip.Tip="Send Message"
                            Classes="accent"
                            Command="{Binding ActiveConversation.SendMessageCommand}"
                            Height="36" Width="36"
                            Padding="0"
                            Margin="8,0,0,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= RIGHT COLUMN: COLLAPSIBLE DETAILS DRAWER ================= -->
        <Border Grid.Column="3" Width="300" Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemChromeMediumColor}" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsDetailsOpen}">
            <ScrollViewer>
                <StackPanel Spacing="16" Margin="16">
                    <!-- Drawer Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Details &amp; Security" FontWeight="Bold" FontSize="15" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding ToggleDetailsCommand}" Padding="6,2" />
                    </Grid>

                    <!-- Contact Details -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Contact JID" FontSize="11" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Text="{Binding ActiveConversation.RemoteJid}" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>

                    <Separator />

                    <!-- OMEMO E2EE Fingerprints -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="OMEMO Device Fingerprints" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Verify device identity keys to ensure communication is secure against eavesdropping." Classes="muted" TextWrapping="Wrap" FontSize="11" />

                        <ItemsControl ItemsSource="{Binding OmemoDetails.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OmemoDeviceItemViewModel}">
                                    <Border Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="8" Padding="10" Margin="0,4">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding DeviceId, StringFormat='Device #{0}'}" FontWeight="Medium" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding TrustState}" FontSize="11" Classes="muted" />
                                            </Grid>
                                            <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas, monospace" FontSize="10" Classes="muted" TextWrapping="Wrap" />
                                            <Button Content="{Binding IsTrusted, Converter={StaticResource BoolToLockIcon}}"
                                                    Command="{Binding ToggleTrustCommand}"
                                                    HorizontalAlignment="Right" FontSize="11" Padding="8,4" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
