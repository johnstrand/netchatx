<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:NetChatx.Gui"
             x:Class="NetChatx.Gui.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- NetChatx Signature Cyber-Glass Palette -->
        <Color x:Key="NetChatxCyan">#00F0FF</Color>
        <Color x:Key="NetChatxPurple">#A855F7</Color>
        <Color x:Key="NetChatxDarkBg">#080C14</Color>
        <Color x:Key="NetChatxSurface">#0F172A</Color>
        <Color x:Key="NetChatxSurfaceAlt">#1E293B</Color>
        <Color x:Key="NetChatxBorder">#1E293B</Color>
        <Color x:Key="NetChatxBorderHighlight">#334155</Color>

        <LinearGradientBrush x:Key="NetChatxCyberGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#7C3AED" Offset="0.0" />
            <GradientStop Color="#00C8FF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NetChatxCyberGradientHover" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#8B5CF6" Offset="0.0" />
            <GradientStop Color="#38BDF8" Offset="1.0" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="NetChatxCyanBrush" Color="#00F0FF" />
        <SolidColorBrush x:Key="NetChatxPurpleBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="NetChatxDarkBgBrush" Color="#080C14" />
        <SolidColorBrush x:Key="NetChatxSurfaceBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="NetChatxSurfaceAltBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="NetChatxBorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="NetChatxBorderHighlightBrush" Color="#334155" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.inline-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.inline-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!-- Cyber Accent Button Style -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource NetChatxCyberGradient}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NetChatxCyberGradientHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6D28D9" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>

        <!-- Uniform 32x32 Icon Button Styles -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D3B55" />
            <Setter Property="BorderBrush" Value="{DynamicResource NetChatxCyanBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NetChatxCyanBrush}" />
        </Style>
        <Style Selector="Button.icon-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#162032" />
            <Setter Property="BorderBrush" Value="{DynamicResource NetChatxCyanBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NetChatxCyanBrush}" />
        </Style>
        <Style Selector="Button.icon-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#131B2B" />
            <Setter Property="BorderBrush" Value="#1E293B" />
            <Setter Property="Foreground" Value="#475569" />
        </Style>

        <!-- Accent Icon Button (Send, Confirm, Add) -->
        <Style Selector="Button.icon-btn.accent">
            <Setter Property="Background" Value="{DynamicResource NetChatxCyberGradient}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.icon-btn.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NetChatxCyberGradientHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.icon-btn.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6D28D9" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Subtle Icon Button (Transparent by default) -->
        <Style Selector="Button.icon-btn.subtle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#64748B" />
        </Style>
        <Style Selector="Button.icon-btn.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource NetChatxCyanBrush}" />
        </Style>

        <!-- Danger Icon Button (Disconnect, Delete) -->
        <Style Selector="Button.icon-btn.danger">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Foreground" Value="#F43F5E" />
        </Style>
        <Style Selector="Button.icon-btn.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2B141D" />
            <Setter Property="BorderBrush" Value="#F43F5E" />
            <Setter Property="Foreground" Value="#FDA4AF" />
        </Style>

        <!-- Uniform DropDownButton Style -->
        <Style Selector="DropDownButton.icon-btn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="DropDownButton.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
        </Style>
        <Style Selector="DropDownButton.icon-btn /template/ PathIcon#PART_DropDownGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Application.Styles>
</Application>
