<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stanza.Gui.ViewModels"
             xmlns:services="using:Stanza.Gui.Services"
             xmlns:views="using:Stanza.Gui.Views"
             xmlns:conv="using:Stanza.Gui.Converters"
             xmlns:controls="using:Stanza.Gui.Controls"
             x:Class="Stanza.Gui.Views.MainChatView"
             x:DataType="vm:MainChatViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Resources>
        <conv:DirectionToAlignmentConverter x:Key="DirectionToAlignment" />
        <conv:DirectionToBackgroundConverter x:Key="DirectionToBackground" />
        <conv:DirectionToForegroundConverter x:Key="DirectionToForeground" />
        <conv:PresenceToBrushConverter x:Key="PresenceToBrush" />
        <conv:BoolToLockIconConverter x:Key="BoolToLockIcon" />
        <conv:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrush" />
        <conv:BoolToRailBackgroundConverter x:Key="BoolToRailBackground" />
    </UserControl.Resources>

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding OpenNewChatDialogCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenChatSettingsCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding OpenHelpCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <Style Selector="Button.image-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.image-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.reaction-picker-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.reaction-picker-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Button.reaction-badge">
            <Setter Property="Background" Value="#162032" />
            <Setter Property="BorderBrush" Value="#24334C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Button.reaction-badge.reacted">
            <Setter Property="Background" Value="#2A1B4E" />
            <Setter Property="BorderBrush" Value="#A855F7" />
        </Style>
        <Style Selector="Border.bubble-container">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#23324C" />
            <Setter Property="BoxShadow" Value="0 2 8 0 #25000000" />
        </Style>
        <Style Selector="Border.bubble-container.action-bubble">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        <Style Selector="Border.bubble-container StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.bubble-container:pointerover StackPanel.bubble-actions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.quick-emoji-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="Button.quick-emoji-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E293B" />
        </Style>

        <!-- Pill Attachment Button -->
        <Style Selector="Button.pill-attach-btn">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pill-attach-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>

        <!-- Pill Send Button -->
        <Style Selector="Button.pill-send-btn">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pill-send-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Seamless pill textboxes -->
        <Style Selector="Border TextBox#MessageInputBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border TextBox#MessageInputBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border TextBox#MessageInputBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border TextBox#SearchInputBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border TextBox#SearchInputBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border TextBox#SearchInputBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Navigation Tabs styling -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#38BDF8" />
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="#F8FAFC" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="56,*">
        <!-- ================= ACCOUNT RAIL (LEFT STRIP) ================= -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="0,10">
                <!-- Top: All Accounts Button -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8">
                    <Button Command="{Binding SelectAllAccountsCommand}"
                            ToolTip.Tip="{DynamicResource Accounts_AllAccounts}"
                            AutomationProperties.Name="All Accounts"
                            Width="40" Height="40" CornerRadius="12"
                            Background="{Binding IsAllAccountsSelected, Converter={StaticResource BoolToRailBackground}}"
                            BorderBrush="#00F0FF"
                            BorderThickness="1"
                            Padding="0">
                        <Panel>
                            <TextBlock Text="🌐" FontSize="18" Foreground="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Background="#F43F5E" CornerRadius="8" Padding="4,1" Margin="0,0,-4,-4"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    IsVisible="{Binding SessionManager.TotalUnreadCount}">
                                <TextBlock Text="{Binding SessionManager.TotalUnreadCount}" Foreground="White" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </Panel>
                    </Button>
                    <Rectangle Width="32" Height="1" Fill="#1E293B" />
                </StackPanel>

                <!-- Middle: Individual Accounts List -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,8">
                    <ItemsControl ItemsSource="{Binding SessionManager.Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:AccountSession}">
                                <Button Command="{Binding ((vm:MainChatViewModel)DataContext).SelectAccountSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        ToolTip.Tip="{Binding DisplayName}"
                                        Width="40" Height="40" Margin="0,4" CornerRadius="20"
                                        Padding="0" Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Center">
                                    <Panel Width="40" Height="40">
                                        <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{Binding AvatarBackgroundBrush}">
                                            <Panel>
                                                <Image Source="{Binding UserAvatar}" Width="40" Height="40" Stretch="UniformToFill" IsVisible="{Binding HasUserAvatar}" />
                                                <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasUserAvatar}"
                                                           Foreground="White" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                        </Border>
                                        <!-- Connection Status Dot -->
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding ConnectionState, Converter={StaticResource ConnectionStateToBrush}}"
                                                 Stroke="#0F172A" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        <!-- Unread count badge -->
                                        <Border Background="#F43F5E" CornerRadius="8" Padding="4,1" Margin="0,-2,-2,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                IsVisible="{Binding HasUnread}">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Panel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom: Add Account Button -->
                <Button Grid.Row="2" Command="{Binding OpenAddAccountDialogCommand}"
                        ToolTip.Tip="{DynamicResource Settings_AddAccount}"
                        AutomationProperties.Name="Add Account"
                        Width="36" Height="36" CornerRadius="18"
                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                        Padding="0" HorizontalAlignment="Center">
                    <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#00F0FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ================= MAIN CHAT ROOT ================= -->
        <Grid Grid.Column="1" x:Name="RootChatGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <!-- ================= LEFT COLUMN: SIDEBAR ================= -->
        <Grid x:Name="SidebarGrid" Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto"
              Background="#182436"
              IsVisible="{Binding IsSidebarOpen}">

            <!-- Row 0: App Branding Header -->
            <Border Grid.Row="0" Padding="16,14,14,14" Background="#182436"
                    BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Logo & Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" ClipToBounds="True">
                            <Image Source="/Assets/stanza-logo.png" Width="28" Height="28" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock Text="Stanza" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Collapse Sidebar Button -->
                    <Button Grid.Column="2" Content="◀"
                            ToolTip.Tip="{DynamicResource Sidebar_Collapse_Tooltip}"
                            Command="{Binding CollapseSidebarCommand}"
                            AutomationProperties.Name="Collapse sidebar"
                            Classes="icon-btn subtle"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Row 1: Search Bar & New Chat Button -->
            <Border Grid.Row="1" Padding="12,10" Background="#182436" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Grid.Column="0" Background="#131C2D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="18" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="SearchInputBox" Grid.Column="1"
                                     Text="{Binding SearchQuery, Mode=TwoWay}"
                                     Watermark="{DynamicResource Sidebar_SearchMessages_Watermark}"
                                     AutomationProperties.Name="Search messages"
                                     TabIndex="10"
                                     Height="34" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="12" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="+"
                            ToolTip.Tip="{DynamicResource Sidebar_StartNewChat_Tooltip}"
                            Command="{Binding OpenNewChatDialogCommand}"
                            AutomationProperties.Name="Start new chat"
                            TabIndex="11"
                            Classes="icon-btn accent"
                            Width="34" Height="34" CornerRadius="17"
                            FontSize="16" FontWeight="Bold"
                            Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Row 2: Search Results or Tabs (Chats & Contacts) -->
            <!-- Search Results View -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding IsSearching}">
                <Border Grid.Row="0" Padding="12,6" Background="#182436" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding SearchResultsHeader}" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseSearchCommand}" ToolTip.Tip="{DynamicResource Sidebar_CloseSearch_Tooltip}" AutomationProperties.Name="Close search" Classes="icon-btn subtle" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}"
                         AutomationProperties.Name="Search results"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MessageBubbleViewModel}">
                            <Button Command="{Binding ((vm:MainChatViewModel)DataContext).SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding SenderDisplayName}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" Padding="8,6">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SenderDisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#00F0FF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedDateTime}" Foreground="#64748B" FontSize="10" />
                                    </Grid>
                                    <TextBlock Text="{Binding Body}" Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Normal Navigation Tabs (Chats / Contacts) -->
            <TabControl Grid.Row="2" IsVisible="{Binding !IsSearching}" Margin="0">
                <!-- Chats Tab -->
                <TabItem Header="{DynamicResource Nav_Chats}" AutomationProperties.Name="Chats">
                    <ListBox ItemsSource="{Binding Conversations}"
                             SelectedItem="{Binding ActiveConversation, Mode=TwoWay}"
                             AutomationProperties.Name="Conversations"
                             TabIndex="12"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatConversationViewModel}">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,4">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Block Contact"
                                                      IsVisible="{Binding !IsBlocked}"
                                                      Command="{Binding ((vm:MainChatViewModel)DataContext).BlockContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Unblock Contact"
                                                      IsVisible="{Binding IsBlocked}"
                                                      Command="{Binding ((vm:MainChatViewModel)DataContext).UnblockContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <!-- Avatar with Live Presence Dot -->
                                    <Panel Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{Binding AvatarBackgroundBrush}">
                                            <Panel>
                                                <Image Source="{Binding Avatar}" Width="40" Height="40" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                                                <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasAvatar}"
                                                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                        </Border>
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding PresenceShow, Converter={StaticResource PresenceToBrush}}"
                                                 Stroke="#182436"
                                                 StrokeThickness="2"
                                                 Margin="0,0,1,1"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Panel>
                                    <!-- Text info -->
                                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                        <!-- Top row: Title and LastMessageTime -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                <Border Background="#3B1824" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="4,1" IsVisible="{Binding IsBlocked}" VerticalAlignment="Center">
                                                    <TextBlock Text="Blocked" FontSize="9" FontWeight="Bold" Foreground="#F87171" />
                                                </Border>
                                                <Border Background="{Binding AccountBrush}" CornerRadius="4" Padding="4,1" IsVisible="{Binding ShowAccountBadge}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AccountBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#0B0F19" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LastMessageTime}" FontSize="11" Foreground="#64748B" Margin="6,0,0,0" />
                                        </Grid>
                                        <!-- Bottom row: Snippet or RemoteJid -->
                                        <TextBlock Grid.Row="1" Text="{Binding LastMessageSnippet, FallbackValue=''}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,2,0,0" />
                                    </Grid>
                                    <!-- Encryption indicator -->
                                    <TextBlock Grid.Column="2" Text="🔒" IsVisible="{Binding IsEncrypted}" FontSize="11" Foreground="#00F0FF" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>

                <!-- Contacts Roster Tab -->
                <TabItem Header="{DynamicResource Nav_Contacts}" AutomationProperties.Name="Contacts">
                    <ListBox ItemsSource="{Binding Contacts}"
                             AutomationProperties.Name="Contacts"
                             TabIndex="13"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContactItemViewModel}">
                                <Button Command="{Binding ((vm:MainChatViewModel)DataContext).SelectContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Padding="4,4">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Block Contact"
                                                      IsVisible="{Binding !IsBlocked}"
                                                      Command="{Binding ((vm:MainChatViewModel)DataContext).BlockContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Unblock Contact"
                                                      IsVisible="{Binding IsBlocked}"
                                                      Command="{Binding ((vm:MainChatViewModel)DataContext).UnblockContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Avatar circle with presence dot -->
                                        <Panel Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Background="{Binding AvatarBackgroundBrush}">
                                                <Panel>
                                                    <Image Source="{Binding Avatar}" Width="40" Height="40" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                                                    <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasAvatar}"
                                                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Panel>
                                            </Border>
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding PresenceShow, Converter={StaticResource PresenceToBrush}}"
                                                     Stroke="#182436"
                                                     StrokeThickness="2"
                                                     Margin="0,0,1,1"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                                <Border Background="#3B1824" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="4,1" IsVisible="{Binding IsBlocked}" VerticalAlignment="Center">
                                                    <TextBlock Text="Blocked" FontSize="9" FontWeight="Bold" Foreground="#F87171" />
                                                </Border>
                                                <Border Background="{Binding AccountBrush}" CornerRadius="4" Padding="4,1" IsVisible="{Binding ShowAccountBadge}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AccountBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#0B0F19" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ContactJid}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- Unread badge -->
                                        <Border Grid.Column="2" Background="{StaticResource StanzaCyberGradient}"
                                                CornerRadius="10" Padding="6,2"
                                                IsVisible="{Binding UnreadCount}" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>

            <!-- Row 3: Bottom User Profile & Controls Bar -->
            <Border Grid.Row="3" Padding="12,10" Background="#182436"
                    BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <!-- User Avatar with Presence Dot -->
                    <Panel Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Command="{Binding OpenProfileSettingsCommand}"
                                ToolTip.Tip="{DynamicResource Sidebar_ProfileSettings_Tooltip}"
                                AutomationProperties.Name="User profile settings"
                                Classes="image-btn"
                                Width="36" Height="36" Padding="0" Cursor="Hand">
                            <Panel Width="36" Height="36">
                                <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True" Background="{Binding UserAvatarBackgroundBrush}">
                                    <Panel>
                                        <Image Source="{Binding UserAvatar}" Width="36" Height="36" Stretch="UniformToFill" IsVisible="{Binding HasUserAvatar}" />
                                        <TextBlock Text="{Binding UserInitials}" IsVisible="{Binding !HasUserAvatar}"
                                                   Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </Border>
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding UserPresence, Converter={StaticResource PresenceToBrush}}"
                                         Stroke="#182436"
                                         StrokeThickness="2"
                                         Margin="0,0,1,1"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Panel>
                        </Button>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserBoundJid}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusMessage}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Status Menu Button -->
                    <Button Grid.Column="2" Content="●"
                            Classes="icon-btn subtle"
                            ToolTip.Tip="{DynamicResource Sidebar_SetStatus_Tooltip}"
                            AutomationProperties.Name="Change presence status"
                            Foreground="{Binding UserPresence, Converter={StaticResource PresenceToBrush}}"
                            Margin="2,0,2,0">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{DynamicResource Status_Online}" Command="{Binding SetPresenceCommand}" CommandParameter="available" />
                                <MenuItem Header="{DynamicResource Status_Away}" Command="{Binding SetPresenceCommand}" CommandParameter="away" />
                                <MenuItem Header="{DynamicResource Status_Dnd}" Command="{Binding SetPresenceCommand}" CommandParameter="dnd" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Preferences / Settings Button -->
                    <Button Grid.Column="3" Content="⚙"
                            Command="{Binding OpenChatSettingsCommand}"
                            ToolTip.Tip="{DynamicResource Sidebar_Preferences_Tooltip}"
                            AutomationProperties.Name="Preferences and settings"
                            TabIndex="14"
                            Classes="icon-btn"
                            Margin="2,0,2,0" />
                    <!-- Disconnect Button -->
                    <Button Grid.Column="4" Content="⏻"
                            Command="{Binding DisconnectCommand}"
                            ToolTip.Tip="{DynamicResource Sidebar_Disconnect_Tooltip}"
                            AutomationProperties.Name="Disconnect"
                            TabIndex="15"
                            Classes="icon-btn danger"
                            Margin="2,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Column 1: Grid Splitter -->
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="2"
                      Background="#1E293B"
                      ResizeDirection="Columns"
                      IsVisible="{Binding IsSidebarOpen}" />

        <!-- ================= CENTER COLUMN: CONVERSATION PANE ================= -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto" Background="#131e2d">

            <!-- Top Chat Header (Active Conversation) -->
            <StackPanel Grid.Row="0" Background="#131e2d"
                        IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Padding="16,10">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                        <!-- Toggle/Restore Sidebar Button -->
                        <Button Grid.Column="0"
                                Content="{Binding SidebarToggleIcon}"
                                ToolTip.Tip="{Binding SidebarToggleTooltip}"
                                Command="{Binding ToggleSidebarCommand}"
                                AutomationProperties.Name="Toggle sidebar"
                                Classes="icon-btn subtle"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />
                        <!-- Contact Avatar with Live Presence Dot -->
                        <Panel Grid.Column="1" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="19"
                                    ClipToBounds="True" Background="{Binding ActiveConversation.AvatarBackgroundBrush}">
                                <Panel>
                                    <Image Source="{Binding ActiveConversation.Avatar}" Width="38" Height="38" Stretch="UniformToFill" IsVisible="{Binding ActiveConversation.HasAvatar}" />
                                    <TextBlock Text="{Binding ActiveConversation.Initials}" IsVisible="{Binding !ActiveConversation.HasAvatar}"
                                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Border>
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding ActiveConversation.PresenceShow, Converter={StaticResource PresenceToBrush}}"
                                     Stroke="#131e2d"
                                     StrokeThickness="2"
                                     Margin="0,0,1,1"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Panel>
                        <!-- Contact Name & Presence Subtitle -->
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveConversation.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ActiveConversation.PresenceStatusText}"
                                       FontSize="11"
                                       Foreground="{Binding ActiveConversation.PresenceShow, Converter={StaticResource PresenceToBrush}}" />
                        </StackPanel>
                        <!-- Encryption Badge -->
                        <Border Grid.Column="3" Background="#11243A" BorderBrush="#00F0FF" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,10,0"
                                IsVisible="{Binding ActiveConversation.IsEncrypted}" VerticalAlignment="Center">
                            <TextBlock Text="🔒 OMEMO" FontSize="11" FontWeight="SemiBold" Foreground="#67E8F9" />
                        </Border>
                        <!-- Sync Button -->
                        <Button Grid.Column="4"
                                Content="{Binding ActiveConversation.SyncButtonIcon}"
                                ToolTip.Tip="{Binding ActiveConversation.SyncButtonText}"
                                Command="{Binding ActiveConversation.SyncArchiveCommand}"
                                IsEnabled="{Binding !ActiveConversation.IsSyncing}"
                                Classes="icon-btn"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />
                        <!-- Export Conversation Button -->
                        <Button Grid.Column="5"
                                Content="💾"
                                ToolTip.Tip="{DynamicResource Chat_Export_Tooltip}"
                                Command="{Binding ActiveConversation.RequestExportChatCommand}"
                                AutomationProperties.Name="Export chat conversation"
                                Classes="icon-btn"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />
                        <!-- Help & About Dropdown Menu -->
                        <Button Grid.Column="6"
                                Content="?"
                                ToolTip.Tip="Help &amp; About"
                                Classes="icon-btn"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="❓ Help &amp; Feature Guide" InputGesture="F1" Command="{Binding OpenHelpCommand}" />
                                    <MenuItem Header="ℹ️ About Stanza" Command="{Binding OpenAboutCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <!-- Details & Security Menu (⋮) -->
                        <Button Grid.Column="7"
                                Content="⋮"
                                ToolTip.Tip="{DynamicResource Chat_DetailsAndSecurity}"
                                Command="{Binding ToggleDetailsCommand}"
                                AutomationProperties.Name="Details and security"
                                Classes="icon-btn"
                                FontSize="15"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- HR Divider -->
                <Rectangle Height="1" Fill="#1E293B" Margin="16,0" HorizontalAlignment="Stretch" />

                <!-- Conversation Search -->
                <Border Padding="16,8,16,6">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ConversationSearchInputBox"
                                 Grid.Column="0"
                                 Text="{Binding ActiveConversation.ConversationSearchQuery, Mode=TwoWay}"
                                 Watermark="Search in this conversation"
                                 FontSize="12"
                                 MinHeight="32"
                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ActiveConversation.ConversationSearchSummary}"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="↑"
                                ToolTip.Tip="Previous match"
                                Command="{Binding ActiveConversation.PreviousConversationSearchResultCommand}"
                                IsEnabled="{Binding ActiveConversation.HasConversationSearchResults}"
                                Classes="icon-btn subtle"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="↓"
                                ToolTip.Tip="Next match"
                                Command="{Binding ActiveConversation.NextConversationSearchResultCommand}"
                                IsEnabled="{Binding ActiveConversation.HasConversationSearchResults}"
                                Classes="icon-btn subtle"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="4"
                                Content="✕"
                                ToolTip.Tip="Clear conversation search"
                                Command="{Binding ActiveConversation.ClearConversationSearchCommand}"
                                Classes="icon-btn subtle"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Blocked Contact Warning Banner -->
                <Border Background="#3B1824" BorderBrush="#EF4444" BorderThickness="0,1,0,1" Padding="14,8"
                        IsVisible="{Binding ActiveConversation.IsBlocked, FallbackValue=False}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🚫" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="This contact is blocked. You will not receive messages or presence updates from them."
                                       Foreground="#FCA5A5" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Unblock"
                                Command="{Binding UnblockActiveConversationCommand}"
                                Classes="action-btn"
                                Background="#EF4444" Foreground="White"
                                Padding="12,3" FontSize="11" CornerRadius="4" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Top Header Bar when no active conversation and sidebar is collapsed -->
            <StackPanel Grid.Row="0" Background="#131e2d"
                        IsVisible="{Binding ShowEmptyStateHeader}">
                <Border Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0" Content="▶"
                                ToolTip.Tip="{DynamicResource Sidebar_Restore_Tooltip}"
                                Command="{Binding RestoreSidebarCommand}"
                                AutomationProperties.Name="Restore sidebar"
                                Classes="icon-btn"
                                HorizontalAlignment="Left" />
                        <Button Grid.Column="1"
                                Content="?"
                                ToolTip.Tip="Help &amp; About"
                                AutomationProperties.Name="Help and About"
                                Classes="icon-btn"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="❓ Help &amp; Feature Guide" InputGesture="F1" Command="{Binding OpenHelpCommand}" />
                                    <MenuItem Header="ℹ️ About Stanza" Command="{Binding OpenAboutCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>
                <!-- HR Divider -->
                <Rectangle Height="1" Fill="#1E293B" Margin="16,0" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Center: Messages Scroll Area -->
            <Grid Grid.Row="1" IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ScrollViewer x:Name="MessagesScrollViewer"
                              FontFamily="{Binding ChatFontFamily}"
                              FontSize="{Binding ChatFontSize}"
                              AutomationProperties.Name="Messages"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="16">
                        <!-- Load Older Messages Button -->
                        <Button Content="{Binding ActiveConversation.LoadOlderButtonIcon}"
                                ToolTip.Tip="{Binding ActiveConversation.LoadOlderButtonText}"
                                Command="{Binding ActiveConversation.LoadOlderHistoryCommand}"
                                IsEnabled="{Binding !ActiveConversation.IsLoadingOlderHistory}"
                                AutomationProperties.Name="Load older messages"
                                Classes="icon-btn"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8" />

                        <!-- Messages List -->
                        <ItemsControl ItemsSource="{Binding ActiveConversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MessageBubbleViewModel}">
                                    <StackPanel Margin="0,2">
                                        <!-- Sleek horizontal rule date divider -->
                                        <Grid Margin="0,14,0,10" HorizontalAlignment="Stretch" IsVisible="{Binding ShowDateHeader}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Height="1" Fill="#1E293B" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DateHeader}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                            <Rectangle Grid.Column="2" Height="1" Fill="#1E293B" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        </Grid>

                                        <!-- Message Row (Inbound with Avatar on Left, Outbound Aligned Right) -->
                                        <Grid HorizontalAlignment="{Binding Direction, Converter={StaticResource DirectionToAlignment}}" MaxWidth="620">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Sender circular avatar for Inbound messages -->
                                            <Border Grid.Column="0"
                                                    Width="30" Height="30" CornerRadius="15"
                                                    ClipToBounds="True"
                                                    Background="{Binding AvatarBackgroundBrush}"
                                                    Margin="0,0,8,2"
                                                    VerticalAlignment="Bottom"
                                                    IsVisible="{Binding !IsOutbound}">
                                                <Panel>
                                                    <Image Source="{Binding Avatar}" Width="30" Height="30" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                                                    <TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasAvatar}"
                                                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Panel>
                                            </Border>

                                            <!-- Message Bubble Container -->
                                            <Border Grid.Column="1"
                                                    Classes="bubble-container"
                                                    Classes.action-bubble="{Binding IsActionMessage}"
                                                    Background="{Binding BubbleBackground}"
                                                    BorderBrush="{Binding SearchBorderBrush}"
                                                    BorderThickness="{Binding SearchBorderThickness}"
                                                    CornerRadius="16"
                                                    Padding="12,8">
                                            <Border.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="📋 Copy Text" Command="{Binding CopyTextCommand}" />
                                                    <MenuItem Header="🌐 Open Link" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding Links[0]}" IsVisible="{Binding HasLinks}" />
                                                    <MenuItem Header="📋 Copy Link" Command="{Binding CopyLinkCommand}" CommandParameter="{Binding Links[0]}" IsVisible="{Binding HasLinks}" />
                                                    <MenuItem Header="↩ Reply" Command="{Binding ReplyCommand}" />
                                                    <MenuItem Header="✏️ Edit Message" Command="{Binding EditCommand}" IsVisible="{Binding IsOutbound}" />
                                                    <MenuItem Header="🗑 Delete Message" Command="{Binding DeleteCommand}" />
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <StackPanel Spacing="4">
                                                <!-- Sender Name for group chats + Action Buttons -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding SenderDisplayName}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{Binding BubbleForeground}"
                                                               Opacity="0.85" VerticalAlignment="Center"
                                                               IsVisible="{Binding !IsActionMessage}" />
                                                    <StackPanel Grid.Column="1" Classes="bubble-actions" Orientation="Horizontal" Spacing="4">
                                                        <!-- Emoji Reaction Button with Flyout -->
                                                        <Button Content="😀+" ToolTip.Tip="Add reaction"
                                                                Classes="image-btn reaction-picker-btn"
                                                                FontSize="12" Padding="4,1"
                                                                Foreground="{Binding BubbleForeground}">
                                                            <Button.Flyout>
                                                                <Flyout Placement="Top">
                                                                    <StackPanel Spacing="6" Width="300" DataContext="{Binding EmojiPicker}">
                                                                        <!-- Quick Emojis Bar + '+' + Customize -->
                                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                                            <ItemsControl Grid.Column="0" ItemsSource="{Binding QuickEmojis}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <WrapPanel Orientation="Horizontal" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate DataType="{x:Type x:String}">
                                                                                        <Button Content="{Binding}"
                                                                                                Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding}"
                                                                                                Classes="quick-emoji-item"
                                                                                                FontSize="17" Padding="3,1"
                                                                                                ToolTip.Tip="{Binding}"
                                                                                                Background="Transparent" BorderThickness="0" Cursor="Hand" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <Button Grid.Column="1" Content="➕"
                                                                                    Command="{Binding ToggleFullPickerCommand}"
                                                                                    ToolTip.Tip="All Emojis"
                                                                                    Classes="image-btn" FontSize="12" Padding="4,2"
                                                                                    VerticalAlignment="Center" Margin="2,0" />

                                                                            <Button Grid.Column="2" Content="⚙"
                                                                                    Command="{Binding ToggleCustomizeCommand}"
                                                                                    ToolTip.Tip="Customize Quick Emojis"
                                                                                    Classes="image-btn" FontSize="12" Padding="4,2"
                                                                                    VerticalAlignment="Center" Margin="2,0" />
                                                                        </Grid>

                                                                        <!-- Customize Banner -->
                                                                        <Border Background="{DynamicResource SystemChromeMediumColor}" CornerRadius="6" Padding="6,4"
                                                                                IsVisible="{Binding IsCustomizing}">
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <TextBlock Grid.Column="0" Text="Click any emoji below or right-click to pin/unpin"
                                                                                           FontSize="10" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                                <Button Grid.Column="1" Content="✓" ToolTip.Tip="Done" Command="{Binding ToggleCustomizeCommand}"
                                                                                        Classes="icon-btn" Margin="4,0,0,0" />
                                                                            </Grid>
                                                                        </Border>

                                                                        <!-- Expandable Full Picker -->
                                                                        <StackPanel Spacing="6" IsVisible="{Binding IsFullPickerOpen}">
                                                                            <Separator Margin="0,2" />

                                                                            <!-- Search Box -->
                                                                            <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                                                                     Watermark="Search emojis..."
                                                                                     FontSize="12" Padding="6,4" />

                                                                            <!-- Category Tabs -->
                                                                            <ItemsControl ItemsSource="{Binding Categories}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Button Content="{Binding Icon}"
                                                                                                Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                CommandParameter="{Binding Name}"
                                                                                                ToolTip.Tip="{Binding Name}"
                                                                                                FontSize="14" Padding="6,2"
                                                                                                Background="Transparent" BorderThickness="0" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <!-- Emojis Grid -->
                                                                            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                                                <ItemsControl ItemsSource="{Binding DisplayedEmojis}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type x:String}">
                                                                                            <Button Content="{Binding}"
                                                                                                    Command="{Binding ((vm:EmojiPickerViewModel)DataContext).SelectEmojiCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                    CommandParameter="{Binding}"
                                                                                                    FontSize="16" Padding="3,2" Margin="1"
                                                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                                                                <Button.ContextFlyout>
                                                                                                    <MenuFlyout>
                                                                                                        <MenuItem Header="📌 Pin to Quick Emojis"
                                                                                                                  Command="{Binding ((vm:EmojiPickerViewModel)DataContext).PinToQuickEmojisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                  CommandParameter="{Binding}" />
                                                                                                        <MenuItem Header="🗑 Remove from Quick Emojis"
                                                                                                                  Command="{Binding ((vm:EmojiPickerViewModel)DataContext).RemoveFromQuickEmojisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                                                  CommandParameter="{Binding}" />
                                                                                                    </MenuFlyout>
                                                                                                </Button.ContextFlyout>
                                                                                            </Button>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Content="↩" Command="{Binding ReplyCommand}"
                                                                ToolTip.Tip="Reply"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding BubbleForeground}" />
                                                        <Button Content="✏️" Command="{Binding EditCommand}"
                                                                ToolTip.Tip="Edit Message"
                                                                IsVisible="{Binding IsOutbound}"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding BubbleForeground}" />
                                                        <Button Content="🗑" Command="{Binding DeleteCommand}"
                                                                ToolTip.Tip="Delete Message"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding BubbleForeground}" />
                                                        <Button Content="📋" Command="{Binding CopyTextCommand}"
                                                                ToolTip.Tip="Copy Text"
                                                                Classes="image-btn" FontSize="11" Padding="4,1"
                                                                Foreground="{Binding BubbleForeground}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Message Content with Clickable Hyperlinks and Markdown -->
                                                <controls:HyperlinkTextBlock Text="{Binding DisplayText}"
                                                                             IsMarkdownEnabled="{Binding !IsUnstyled}"
                                                                             MessageDirection="{Binding Direction}"
                                                                             Foreground="{Binding BubbleForeground}"
                                                                             FontSize="{Binding ((vm:MainChatViewModel)DataContext).ChatFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             FontFamily="{Binding ((vm:MainChatViewModel)DataContext).ChatFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             TextWrapping="Wrap"
                                                                             IsVisible="{Binding !IsOnlyImage}" />

                                                <!-- Image Thumbnail Preview if present -->
                                                <Button Classes="image-btn"
                                                        Command="{Binding OpenImageCommand}"
                                                        CornerRadius="8" ClipToBounds="True" Margin="0,2"
                                                        IsVisible="{Binding IsPreviewVisible}"
                                                        MaxWidth="380" MaxHeight="260" HorizontalAlignment="Left"
                                                        Cursor="Hand">
                                                    <Panel Background="#15888888">
                                                        <!-- Loading indicator -->
                                                        <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                                                                     IsVisible="{Binding IsLoadingImage}"
                                                                     VerticalAlignment="Center" HorizontalAlignment="Center" />

                                                        <!-- Manual download button if auto-download off and not yet loaded -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,8"
                                                                    IsVisible="{Binding ShowManualDownloadButton}">
                                                            <Button Content="📥 Load Image Preview" Command="{Binding LoadMediaCommand}"
                                                                    Classes="accent" FontSize="11" Padding="8,4" />
                                                        </StackPanel>

                                                        <!-- Thumbnail Image -->
                                                        <Image Source="{Binding ImageThumbnail}"
                                                               Stretch="Uniform"
                                                               MaxWidth="380" MaxHeight="260"
                                                               IsVisible="{Binding ImageThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                        <!-- GIF Badge Overlay -->
                                                        <Border Background="#CC000000" CornerRadius="4" Padding="5,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6"
                                                                IsVisible="{Binding IsGif}">
                                                            <TextBlock Text="GIF" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                        </Border>
                                                    </Panel>
                                                </Button>

                                                <!-- Message Reactions Display Badges -->
                                                <ItemsControl ItemsSource="{Binding Reactions}" Margin="0,2,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ReactionCountViewModel}">
                                                            <Button Classes="reaction-badge"
                                                                    Classes.reacted="{Binding IsReactedByMe}"
                                                                    Command="{Binding ToggleCommand}"
                                                                    Margin="0,2,4,2">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding Emoji}" FontSize="12" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Message Footer: Time + Receipt + Raw XML Toggle -->
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                                                        <Button Classes="image-btn"
                                                                Command="{Binding ToggleRawXmlCommand}"
                                                                ToolTip.Tip="Toggle Raw XML"
                                                                Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <TextBlock Text="&lt;/&gt;" FontSize="10" Opacity="0.8"
                                                                       Foreground="{Binding BubbleForeground}" />
                                                        </Button>
                                                        <TextBlock Text="(edited)" FontSize="10" FontStyle="Italic"
                                                                   IsVisible="{Binding IsEdited}"
                                                                   Foreground="{Binding BubbleForeground}"
                                                                   Opacity="0.75" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10"
                                                                   Foreground="{Binding BubbleForeground}"
                                                                   Opacity="0.75" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ReceiptIcon}" FontSize="10"
                                                                   ToolTip.Tip="{Binding ReceiptTooltip}"
                                                                   Foreground="{Binding BubbleForeground}"
                                                                   Opacity="0.9" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Raw XML View Container -->
                                                <Border IsVisible="{Binding IsRawXmlVisible}"
                                                        Background="#20000000"
                                                        CornerRadius="6"
                                                        Padding="8,6"
                                                        Margin="0,4,0,0">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Raw XML" FontSize="10" FontWeight="Bold" Opacity="0.8"
                                                                   Foreground="{Binding BubbleForeground}" />
                                                        <TextBox Text="{Binding RawXml, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 FontFamily="Consolas, monospace"
                                                                 FontSize="11"
                                                                 MaxHeight="180"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Foreground="{Binding BubbleForeground}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                        <!-- Read Marker Horizontal Line Divider across entire chat window -->
                                        <Grid Margin="0,10,0,6"
                                              HorizontalAlignment="Stretch"
                                              IsVisible="{Binding ShowReadMarkerDivider}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Height="1" Fill="#00F0FF" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border Grid.Column="1" Background="#0B0F19" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="10" Padding="12,3">
                                                <TextBlock Text="{Binding ReadMarkerDividerText}" FontSize="10" FontWeight="SemiBold" Foreground="#67E8F9" VerticalAlignment="Center" />
                                            </Border>
                                            <Rectangle Grid.Column="2" Height="1" Fill="#00F0FF" Opacity="0.5" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Dismissible Emoticon Auto-Replacement Info Banner -->
                        <Border HorizontalAlignment="Center"
                                Background="#0F172A"
                                BorderBrush="#00F0FF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,6"
                                Margin="0,8,0,0"
                                IsVisible="{Binding ActiveConversation.ShowEmoticonBanner}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="💡 Emoticons are automatically converted to emojis. You can turn this off or customize snippets in"
                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <Button Content="Chat Settings"
                                            Command="{Binding ActiveConversation.OpenChatSettingsAndDismissBannerCommand}"
                                            Classes="inline-link"
                                            Foreground="#00F0FF"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕"
                                        Command="{Binding ActiveConversation.DismissEmoticonBannerCommand}"
                                        ToolTip.Tip="Dismiss"
                                        Classes="icon-btn subtle"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Dismissible Invalid Slash Command Banner -->
                        <Border HorizontalAlignment="Center"
                                Background="#0F172A"
                                BorderBrush="#00F0FF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,6"
                                Margin="0,8,0,0"
                                IsVisible="{Binding ActiveConversation.ShowSlashCommandWarning}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="⚠️" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveConversation.SlashCommandWarningText}"
                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕"
                                        Command="{Binding ActiveConversation.DismissSlashCommandWarningCommand}"
                                        ToolTip.Tip="Dismiss"
                                        Classes="icon-btn subtle"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Empty State Placeholder when no active conversation -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14"
                        IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNull}}">
                <Border Width="100" Height="100" CornerRadius="24" ClipToBounds="True"
                        HorizontalAlignment="Center"
                        BoxShadow="0 8 28 0 #3000C8FF">
                    <Image Source="/Assets/stanza-logo.png" Width="100" Height="100" Stretch="UniformToFill" />
                </Border>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource Chat_Welcome_Title}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Chat_Welcome_Subtitle}" Classes="muted" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <Button Content="📖 Feature Guide"
                            ToolTip.Tip="Open Help &amp; Feature Guide (F1)"
                            Command="{Binding OpenHelpCommand}"
                            Classes="icon-btn subtle"
                            FontSize="11"
                            Padding="12,5" />
                    <Button Content="ℹ️ About Stanza"
                            ToolTip.Tip="About Stanza, version, and license"
                            Command="{Binding OpenAboutCommand}"
                            Classes="icon-btn subtle"
                            FontSize="11"
                            Padding="12,5" />
                </StackPanel>
                <Button Content="▶"
                        ToolTip.Tip="{DynamicResource Sidebar_Restore_Tooltip}"
                        Command="{Binding RestoreSidebarCommand}"
                        Classes="icon-btn"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        IsVisible="{Binding !IsSidebarOpen}" />
            </StackPanel>

            <!-- Typing Indicator -->
            <Border Grid.Row="2" Padding="16,4" IsVisible="{Binding ActiveConversation.IsRemoteComposing}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ActiveConversation.Title, StringFormat='{}{0} is typing...'}"
                                FontStyle="Italic"
                                Foreground="#00F0FF"
                                FontSize="11" />
                </StackPanel>
            </Border>

            <!-- Bottom Message Input Bar with Floating Pill and Previews -->
            <Border Grid.Row="3" Padding="16,8,16,14" Background="#131e2d"
                    IsVisible="{Binding ActiveConversation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="8">
                    <!-- Pending Image Preview Bar -->
                    <Border Background="#131C2D"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8"
                            IsVisible="{Binding ActiveConversation.HasPendingImage}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Image Thumbnail Preview -->
                            <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True" Width="56" Height="56" Background="#090D16">
                                <Image Source="{Binding ActiveConversation.PendingImagePreview}"
                                       Stretch="UniformToFill" />
                            </Border>

                            <!-- Image Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding ActiveConversation.PendingImageHeader, FallbackValue='📷 Image ready to send'}"
                                               FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" />
                                    <TextBlock Text="{Binding ActiveConversation.PendingImageSizeText, StringFormat='({0})'}"
                                               Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                                <TextBlock Text="{Binding ActiveConversation.PendingImageFileName}"
                                           Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Discard / Remove Button -->
                            <Button Grid.Column="2"
                                    Content="✕"
                                    ToolTip.Tip="Remove Image (Esc)"
                                    Command="{Binding ActiveConversation.ClearPendingImageCommand}"
                                    Classes="icon-btn subtle"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Editing Message Banner -->
                    <Border Background="#1E1B38"
                            BorderBrush="#A855F7"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,6"
                            IsVisible="{Binding ActiveConversation.IsEditingMessage}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="✏️" FontSize="14" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{DynamicResource Chat_EditPreview_EditingMessage}" FontWeight="SemiBold" FontSize="12" Foreground="#00F0FF" />
                                <TextBlock Text="{Binding ActiveConversation.EditingMessagePreviewText}"
                                           Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    ToolTip.Tip="{DynamicResource Chat_CancelEdit}"
                                    Command="{Binding ActiveConversation.CancelEditingMessageCommand}"
                                    Classes="icon-btn subtle"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Replying to Message Banner -->
                    <Border Background="#131C2D"
                            BorderBrush="#00F0FF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,6"
                            IsVisible="{Binding ActiveConversation.HasReplyingMessage}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="↩" FontSize="14" Foreground="#00F0FF" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding ActiveConversation.ReplyingToMessage.SenderDisplayName, StringFormat='Replying to {0}'}"
                                           FontWeight="SemiBold" FontSize="12" Foreground="#00F0FF" />
                                <TextBlock Text="{Binding ActiveConversation.ReplyingToMessage.Body}"
                                           Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="✕"
                                    ToolTip.Tip="{DynamicResource Chat_CancelReply}"
                                    Command="{Binding ActiveConversation.CancelReplyingMessageCommand}"
                                    Classes="icon-btn subtle"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Expression Live Preview Banner -->
                    <Border Background="#131C2D"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12,6"
                            Margin="8,0,8,6"
                            IsVisible="{Binding ActiveConversation.IsExpressionPreviewVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="💡 Preview: " FontWeight="SemiBold" FontSize="11" Foreground="#00F0FF" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ActiveConversation.ExpressionPreviewText}"
                                       Foreground="#E2E8F0" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       VerticalAlignment="Center" Margin="4,0" />
                            <Button Grid.Column="2"
                                    Content="Apply"
                                    ToolTip.Tip="Replace input with evaluated expression"
                                    Command="{Binding ActiveConversation.ApplyExpressionPreviewCommand}"
                                    Classes="image-btn"
                                    FontSize="10.5"
                                    Foreground="#00F0FF"
                                    Cursor="Hand"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Floating Pill Container -->
                    <Border Background="#131C2D"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="5,4,6,4"
                            BoxShadow="0 4 20 0 #40000000">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <!-- Circular '+' Attachment Button -->
                            <Button x:Name="AttachFileButton"
                                    Grid.Column="0"
                                    Content="+"
                                    ToolTip.Tip="{DynamicResource Chat_AttachFile}"
                                    AutomationProperties.Name="Attach file"
                                    TabIndex="20"
                                    Classes="pill-attach-btn" />

                            <!-- Text Input Box -->
                            <TextBox x:Name="MessageInputBox"
                                     Grid.Column="1"
                                     Text="{Binding ActiveConversation.InputText, Mode=TwoWay}"
                                     Watermark="{Binding MessageInputWatermark}"
                                     FontFamily="{Binding ChatFontFamily}"
                                     FontSize="{Binding ChatFontSize}"
                                     AutomationProperties.Name="Message input"
                                     TabIndex="21"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MinLines="1"
                                     MinHeight="36"
                                     MaxLines="{Binding ChatInputMaxLines}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F8FAFC"
                                     Padding="10,8"
                                     VerticalContentAlignment="Center" />

                            <!-- Code Block Button -->
                            <Button x:Name="InsertCodeBlockButton"
                                    Grid.Column="2"
                                    Content="&lt;/&gt;"
                                    ToolTip.Tip="{DynamicResource Chat_InsertCodeBlock}"
                                    AutomationProperties.Name="Insert code block"
                                    TabIndex="22"
                                    Classes="icon-btn subtle"
                                    Width="32" Height="32"
                                    CornerRadius="16"
                                    Margin="2,0,6,0"
                                    VerticalAlignment="Center" />

                            <!-- Circular Royal Blue Send Button -->
                            <Button Grid.Column="3"
                                    Content="➤"
                                    ToolTip.Tip="{Binding ActiveConversation.SendButtonToolTip}"
                                    Command="{Binding ActiveConversation.SendMessageCommand}"
                                    AutomationProperties.Name="Send message"
                                    TabIndex="23"
                                    Classes="pill-send-btn" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= RIGHT COLUMN: COLLAPSIBLE DETAILS DRAWER ================= -->
        <Border Grid.Column="3" Width="300" Background="#0B0F19"
                BorderBrush="#1E293B" BorderThickness="1,0,0,0"
                IsVisible="{Binding IsDetailsOpen}">
            <ScrollViewer>
                <StackPanel Spacing="16" Margin="16">
                    <!-- Drawer Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Chat_DetailsAndSecurity}" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding ToggleDetailsCommand}"
                                ToolTip.Tip="{DynamicResource Common_Close}"
                                Classes="icon-btn subtle" />
                    </Grid>

                    <!-- Contact Details Card -->
                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True"
                                    Background="{Binding ActiveConversation.AvatarBackgroundBrush}"
                                    HorizontalAlignment="Center"
                                    BoxShadow="0 4 16 0 #20000000">
                                <Panel>
                                    <Image Source="{Binding ActiveConversation.Avatar}" Width="64" Height="64" Stretch="UniformToFill" IsVisible="{Binding ActiveConversation.HasAvatar}" />
                                    <TextBlock Text="{Binding ActiveConversation.Initials}" IsVisible="{Binding !ActiveConversation.HasAvatar}"
                                               Foreground="White" FontSize="22" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Border>
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding ActiveConversation.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="{Binding ActiveConversation.RemoteJid}" Classes="muted" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Privacy & Blocking Action -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Privacy" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <Button Content="🚫 Block Contact"
                                Command="{Binding BlockContactCommand}"
                                CommandParameter="{Binding ActiveConversation}"
                                IsVisible="{Binding !ActiveConversation.IsBlocked, FallbackValue=True}"
                                Background="#3B1824" Foreground="#F87171"
                                BorderBrush="#EF4444" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Cursor="Hand" />
                        <Button Content="✓ Unblock Contact"
                                Command="{Binding UnblockActiveConversationCommand}"
                                IsVisible="{Binding ActiveConversation.IsBlocked, FallbackValue=False}"
                                Background="#10B981" Foreground="White"
                                BorderThickness="0"
                                CornerRadius="8" Padding="12,6" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Cursor="Hand" />
                    </StackPanel>

                    <Separator Background="#1E293B" Height="1" />

                    <!-- Chat Preferences & Bubble Merging -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Settings_Tab_Chat}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="{DynamicResource Settings_MessageMerging_Subtitle}" Foreground="#64748B" TextWrapping="Wrap" FontSize="11" />

                        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="10">
                                <ToggleSwitch IsChecked="{Binding EnableMessageMerging, Mode=TwoWay}"
                                              OnContent="{DynamicResource Settings_MessageMerging_Title}"
                                              OffContent="{DynamicResource Settings_MessageMerging_Title}"
                                              FontSize="12" />

                                <StackPanel Spacing="4" IsVisible="{Binding EnableMessageMerging}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Settings_MessageMerging_Threshold}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding MessageMergeThresholdSeconds, StringFormat='{}{0} seconds'}"
                                                   FontWeight="SemiBold" FontSize="11" Foreground="#00F0FF" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="60"
                                            Value="{Binding MessageMergeThresholdSeconds, Mode=TwoWay}"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="{DynamicResource Settings_Header}"
                                Command="{Binding OpenChatSettingsCommand}"
                                Background="#1E293B" Foreground="#94A3B8"
                                BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Cursor="Hand" Margin="0,2,0,0" />

                        <Button Content="{DynamicResource Chat_Export_Button}"
                                Command="{Binding ActiveConversation.RequestExportChatCommand}"
                                Background="#1E293B" Foreground="#94A3B8"
                                BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="11"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Cursor="Hand" Margin="0,4,0,0" />
                    </StackPanel>

                    <Separator Background="#1E293B" Height="1" />

                    <!-- OMEMO E2EE Fingerprints -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Dialog_Security_Fingerprints_Title}" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="{DynamicResource Dialog_Security_Fingerprints_Subtitle}" Foreground="#64748B" TextWrapping="Wrap" FontSize="11" />

                        <ItemsControl ItemsSource="{Binding OmemoDetails.Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OmemoDeviceItemViewModel}">
                                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding DeviceId, StringFormat='Device #{0}'}" FontWeight="Medium" FontSize="12" Foreground="#F8FAFC" />
                                                <TextBlock Grid.Column="1" Text="{Binding TrustState}" FontSize="11" Foreground="#94A3B8" />
                                            </Grid>
                                            <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas, monospace" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" />
                                            <Button Content="{Binding IsTrusted, Converter={StaticResource BoolToLockIcon}}"
                                                    ToolTip.Tip="{DynamicResource Dialog_Security_Trust}"
                                                    Command="{Binding ToggleTrustCommand}"
                                                    Classes="icon-btn"
                                                    HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Separator Background="#1E293B" Height="1" />

                    <!-- About Stanza Branding Card -->
                    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="14" ClipToBounds="True"
                                    HorizontalAlignment="Center"
                                    BoxShadow="0 4 16 0 #3000C8FF">
                                <Image Source="/Assets/stanza-logo.png" Width="56" Height="56" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Stanza" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding AppVersion}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Dialog_Security_About_Subtitle}"
                                       Foreground="#94A3B8" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= NEW CHAT / ADD CONTACT MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding IsNewChatDialogOpen}"
              ZIndex="999">
            <!-- Dark semi-transparent backdrop -->
            <Border Background="#80000000" PointerPressed="OnNewChatBackdropPressed" />
            <!-- Centered Card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" Padding="24" CornerRadius="16"
                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    BoxShadow="0 20 50 0 #60000000, 0 0 25 0 #2000F0FF">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{DynamicResource Dialog_NewChat_Title}" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" />
                            <TextBlock Text="{DynamicResource Dialog_NewChat_Subtitle}" Foreground="#64748B" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelNewChatDialogCommand}"
                                ToolTip.Tip="{DynamicResource Common_Close}"
                                AutomationProperties.Name="Close new chat dialog"
                                Classes="icon-btn subtle" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding IsAllAccountsSelected}">
                        <TextBlock Text="{DynamicResource Settings_Account}" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <ComboBox ItemsSource="{Binding SessionManager.Sessions}"
                                  SelectedItem="{Binding NewChatSelectedSession}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Dialog_NewChat_Jid}" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <TextBox x:Name="NewChatJidInput" Text="{Binding NewChatJid, Mode=TwoWay}"
                                 Watermark="e.g. alice@example.com"
                                 AutomationProperties.Name="Contact Jabber ID"
                                 TabIndex="1"
                                 Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                 Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Dialog_NewChat_DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <TextBox Text="{Binding NewChatDisplayName, Mode=TwoWay}"
                                 Watermark="e.g. Alice Cooper"
                                 AutomationProperties.Name="Contact display name"
                                 TabIndex="2"
                                 Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                 Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding NewChatErrorMessage}"
                               Foreground="#F43F5E" FontSize="11"
                               IsVisible="{Binding NewChatErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Content="✕"
                                ToolTip.Tip="{DynamicResource Common_Cancel}"
                                Command="{Binding CancelNewChatDialogCommand}"
                                AutomationProperties.Name="Cancel"
                                TabIndex="3"
                                Classes="icon-btn"
                                Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="✓"
                                ToolTip.Tip="{DynamicResource Dialog_NewChat_Start}"
                                AutomationProperties.Name="Start chat"
                                TabIndex="4"
                                Classes="icon-btn accent"
                                Command="{Binding ConfirmNewChatCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= ADD ACCOUNT MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding IsAddAccountDialogOpen}"
              ZIndex="1002">
            <Border Background="#80000000" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="440" Padding="24" CornerRadius="16"
                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    BoxShadow="0 20 50 0 #60000000, 0 0 25 0 #2000F0FF">
                <StackPanel Spacing="16" DataContext="{Binding AddAccountDialog}" x:DataType="vm:AddAccountDialogViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{DynamicResource Settings_AddAccount}" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" />
                            <TextBlock Text="{DynamicResource Settings_MultiAccount_AddHint}" Foreground="#64748B" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                                ToolTip.Tip="{DynamicResource Common_Close}"
                                Classes="icon-btn subtle" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Dialog_NewChat_Jid}" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <TextBox Text="{Binding Jid, Mode=TwoWay}"
                                 Watermark="user@domain.com"
                                 Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                 Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Login_Password}" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                        <TextBox Text="{Binding Password, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                 Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                            <TextBlock Text="{DynamicResource Settings_Account_Label}" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding Label, Mode=TwoWay}"
                                     Watermark="e.g. Work, Personal"
                                     Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                     Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                            <TextBlock Text="{DynamicResource Settings_Account_Color}" FontWeight="SemiBold" FontSize="11" Foreground="#94A3B8" />
                            <TextBox Text="{Binding ColorHex, Mode=TwoWay}"
                                     Watermark="#00F0FF"
                                     Background="#090D16" BorderBrush="#1E293B" CornerRadius="8"
                                     Foreground="#F8FAFC" Height="36" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Expander Header="{DynamicResource Login_AdvancedOptions}">
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="2*,*">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="{DynamicResource Login_ServerHost}" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Host, Mode=TwoWay}" Watermark="Optional" Height="32" Background="#090D16" BorderBrush="#1E293B" Foreground="#F8FAFC" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                    <TextBlock Text="{DynamicResource Login_ServerPort}" FontSize="11" Foreground="#94A3B8" />
                                    <TextBox Text="{Binding Port, Mode=TwoWay}" Watermark="5222" Height="32" Background="#090D16" BorderBrush="#1E293B" Foreground="#F8FAFC" />
                                </StackPanel>
                            </Grid>
                            <CheckBox IsChecked="{Binding UseDirectTls}" Content="{DynamicResource Login_UseDirectTls}" Foreground="#CBD5E1" />
                            <CheckBox IsChecked="{Binding AllowUntrustedCertificates}" Content="{DynamicResource Login_AllowUntrustedCerts}" Foreground="#CBD5E1" />
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#F43F5E" FontSize="11"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Content="✕"
                                ToolTip.Tip="{DynamicResource Common_Cancel}"
                                Command="{Binding CloseCommand}"
                                Classes="icon-btn"
                                Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="✓"
                                ToolTip.Tip="{DynamicResource Settings_AddAccount}"
                                Classes="icon-btn accent"
                                Command="{Binding AddAccountCommand}"
                                IsEnabled="{Binding !IsConnecting}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= CODE BLOCK EDITOR MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding CodeBlockEditor.IsOpen}"
              ZIndex="1000">
            <!-- Dark semi-transparent backdrop (click to dismiss/cancel) -->
            <Border Background="#80000000" PointerPressed="OnCodeBlockEditorBackdropPressed" />
            <!-- Centered Modal Editor Card -->
            <views:CodeBlockEditorView DataContext="{Binding CodeBlockEditor}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
        </Grid>

        <!-- ================= SETTINGS / CONFIGURATION MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding Settings.IsOpen}"
              ZIndex="998">
            <!-- Dark semi-transparent backdrop (click to dismiss) -->
            <Border Background="#80000000" PointerPressed="OnSettingsBackdropPressed" />
            <!-- Centered Modal Settings Card -->
            <views:SettingsView DataContext="{Binding Settings}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
        </Grid>

        <!-- ================= HELP & FEATURE GUIDE MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding Help.IsOpen}"
              ZIndex="997">
            <!-- Dark semi-transparent backdrop (click to dismiss) -->
            <Border Background="#80000000" PointerPressed="OnHelpBackdropPressed" />
            <!-- Centered Modal Help Card -->
            <views:HelpView DataContext="{Binding Help}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Grid>

        <!-- ================= ABOUT MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding About.IsOpen}"
              ZIndex="997">
            <!-- Dark semi-transparent backdrop (click to dismiss) -->
            <Border Background="#80000000" PointerPressed="OnAboutBackdropPressed" />
            <!-- Centered Modal About Card -->
            <views:AboutView DataContext="{Binding About}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
        </Grid>

        <!-- ================= CLOSE PROMPT CHOICE MODAL OVERLAY ================= -->
        <Grid Grid.Column="0" Grid.ColumnSpan="4"
              IsVisible="{Binding IsClosePromptOpen}"
              ZIndex="1001">
            <!-- Dark semi-transparent backdrop -->
            <Border Background="#80000000" />
            <!-- Centered Card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" Padding="24" CornerRadius="16"
                    Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1"
                    BoxShadow="0 20 50 0 #60000000, 0 0 25 0 #2000F0FF">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{DynamicResource Dialog_Close_Title}" FontWeight="Bold" FontSize="16" Foreground="#F8FAFC" />
                            <TextBlock Text="{DynamicResource Dialog_Close_Subtitle}" Foreground="#64748B" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CancelClosePromptCommand}"
                                ToolTip.Tip="{DynamicResource Common_Cancel}"
                                AutomationProperties.Name="Cancel"
                                Classes="icon-btn subtle" />
                    </Grid>

                    <TextBlock Text="{DynamicResource Dialog_Close_Message}"
                               Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />

                    <!-- Remember my choice CheckBox -->
                    <CheckBox IsChecked="{Binding RememberCloseChoice, Mode=TwoWay}"
                              Content="{DynamicResource Dialog_Close_Remember}"
                              AutomationProperties.Name="Remember choice"
                              FontSize="11.5" Foreground="#94A3B8" />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="0" Content="{DynamicResource Common_Cancel}"
                                Command="{Binding CancelClosePromptCommand}"
                                AutomationProperties.Name="Cancel"
                                Background="#1E293B" Foreground="#94A3B8"
                                BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="11.5" Cursor="Hand" />

                        <Button Grid.Column="1" Content="{DynamicResource Dialog_Close_Exit}"
                                Command="{Binding ChooseExitAppCommand}"
                                AutomationProperties.Name="Exit application"
                                Background="#1E293B" Foreground="#F43F5E"
                                BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="8" Padding="14,6" FontSize="11.5" Cursor="Hand"
                                Margin="8,0,0,0" />

                        <Button Grid.Column="2" Content="{DynamicResource Dialog_Close_Minimize}"
                                Command="{Binding ChooseMinimizeToTrayCommand}"
                                AutomationProperties.Name="Minimize to tray"
                                Classes="accent"
                                Padding="16,6" FontSize="11.5"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Grid>
</UserControl>
