<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Stanza.Gui.ViewModels"
             x:Class="Stanza.Gui.Views.CodeBlockEditorView"
             x:DataType="vm:CodeBlockEditorViewModel">

    <Border Width="680" MaxWidth="800"
            MinHeight="440" MaxHeight="620"
            Background="#0F172A"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="16"
            BoxShadow="0 24 64 0 #80000000, 0 0 36 0 #1800F0FF"
            Padding="22">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Row 0: Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{StaticResource StanzaCyberGradient}"
                            CornerRadius="8" Width="30" Height="30">
                        <TextBlock Text="&lt;/&gt;" FontWeight="Bold" FontSize="12"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Dialog_CodeBlock_Title}" FontWeight="Bold" FontSize="16"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2" Content="✕"
                        Classes="icon-btn subtle"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="{DynamicResource Settings_Close_Tooltip}" />
            </Grid>

            <!-- Row 1: Language Picker Bar -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,200,*" Margin="0,0,0,12">
                <TextBlock Grid.Column="0" Text="{DynamicResource Dialog_CodeBlock_Language}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1"
                          x:Name="LanguageComboBox"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CodeLanguageItem">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Custom Language Identifier Input (Visible when 'Custom...' is selected) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0"
                            IsVisible="{Binding IsCustomLanguage}">
                    <TextBlock Text="{DynamicResource Dialog_CodeBlock_Tag}" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Text="{Binding CustomLanguageIdentifier, Mode=TwoWay}"
                             Watermark="e.g. zig, clojure" Width="140"
                             VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Row 2: Code Editor Container -->
            <Border Grid.Row="2"
                    Background="#090D16"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Line Numbers Gutter -->
                    <Border Grid.Column="0"
                            Background="#06090F"
                            BorderBrush="#1E293B"
                            BorderThickness="0,0,1,0"
                            Padding="8,10,8,10"
                            MinWidth="36">
                        <ScrollViewer x:Name="LineNumbersScrollViewer"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding LineNumbersText}"
                                       FontFamily="Consolas, 'Cascadia Code', 'Fira Code', 'DejaVu Sans Mono', 'Courier New', monospace"
                                       FontSize="12"
                                       LineHeight="20"
                                       Foreground="#6B7280"
                                       TextAlignment="Right" />
                        </ScrollViewer>
                    </Border>

                    <!-- Code Input Text Area -->
                    <TextBox x:Name="CodeEditorTextBox"
                             Grid.Column="1"
                             Text="{Binding Code, Mode=TwoWay}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             FontFamily="Consolas, 'Cascadia Code', 'Fira Code', 'DejaVu Sans Mono', 'Courier New', monospace"
                             FontSize="12"
                             LineHeight="20"
                             Foreground="#F3F4F6"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="10"
                             TextWrapping="NoWrap"
                             Watermark="{DynamicResource Dialog_CodeBlock_Watermark}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <!-- Row 3: Footer Action Bar -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
                <!-- Line & Char Count -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" />
                    <TextBlock Text="•" Classes="muted" FontSize="11" />
                    <TextBlock Text="{DynamicResource Dialog_CodeBlock_Hint}" Classes="muted" FontSize="11" />
                </StackPanel>

                <!-- Action Buttons -->
                <Button Grid.Column="2" Content="✕"
                        ToolTip.Tip="{DynamicResource Settings_Close_Tooltip}"
                        Command="{Binding CancelCommand}"
                        Classes="icon-btn"
                        Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="✓"
                        ToolTip.Tip="{DynamicResource Dialog_CodeBlock_Insert}"
                        Classes="icon-btn accent"
                        Command="{Binding InsertCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

